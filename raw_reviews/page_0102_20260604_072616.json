alse}, "images": [], "created_at_date": "2016-09-15", "published_at_date": "2016-09-14"}, {"review_id": 418544653, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r418544653-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "cremate plate form where going on every hour within 24", "text": "Hindu pilgrimage site, the Bagmati river goes to Gangis, Hindu does believe after death the body goes into five elements such as fire, water,air, earth and sky. after 84 millions reborn they get Human beings or gods.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "business", "stay_date": "2016-08-31"}, "reviewer": {"reviewer_id": "B19969A3F33C50A257C328F8F4CE96CA", "name": "Chandra K", "profile_link": "https://www.tripadvisor.com/Profile/946chandrak", "username": "946chandrak", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/15/cd/e2/9e/chandra-k.jpg", "contribution_count": 39, "hometown": {"tripadvisor_entity_id": 293890, "location_name": "Kathmandu", "location_name_detailed": "Kathmandu, Nepal"}, "is_verified": false}, "images": [], "created_at_date": "2016-09-14", "published_at_date": "2016-09-14"}, {"review_id": 418474575, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r418474575-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Good but...", "text": "We met the temple with small daughter it was amazing for her and for us but some scenes weren't appropriate for young children and people afraid of dead bodies.  Not sanity but you must visit.  So wearing a breath musk is recommended.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2016-09-30"}, "reviewer": {"reviewer_id": "A21AD15439E92B95CC99E1D6BBFE0CA5", "name": "ghasem_pourjafar", "profile_link": "https://www.tripadvisor.com/Profile/ghasem_pourjafar", "username": "ghasem_pourjafar", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e6/ea/default-avatar-2020-54.jpg", "contribution_count": 74, "hometown": null, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/f4/ac/91/20160904-094249-largejpg.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/f4/ac/92/20160904-093456-largejpg.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/f4/ac/93/20160904-092621-largejpg.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/f4/ac/94/20160904-094502-largejpg.jpg"], "created_at_date": "2016-09-14", "published_at_date": "2016-09-14"}, {"review_id": 418376948, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r418376948-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Har har mahadev", "text": "As per my experience Nepal draws visitors who come for a diversity of reasons. Some are lured by the call of the mountains and seeking to climb or trek in the Himalayas, others are intrigued by the culture and the famous city of Kathmandu, and yet others come hoping to find some sort of spiritual awakening. Nepal can be an adrenaline adventure, a cultural eye opener, or a life-changing experience, depending on the itinerary and mindset of the traveler", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "business", "stay_date": "2016-09-30"}, "reviewer": {"reviewer_id": "38487F8604D172ADA6302696DD2C2020", "name": "vencydelhi", "profile_link": "https://www.tripadvisor.com/Profile/vencydelhi", "username": "vencydelhi", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/f2/11/default-avatar-2020-23.jpg", "contribution_count": 32, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2016-09-14", "published_at_date": "2016-09-14"}, {"review_id": 418369508, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r418369508-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Mr", "text": "The best place that I liked in Nepal the pashupathinath temple. Old historical temple a must visit when you are in kathmandu. A huge nandi in front of the temple. Probably the biggest one that I have seen till date. Very good atmosphere very peaceful and invites you to go again and again. Gives me great mental peace on visiting this temple.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2016-09-30"}, "reviewer": {"reviewer_id": "5CEEB545915A68247E2D0C3DB521CCE5", "name": "enarpee", "profile_link": "https://www.tripadvisor.com/Profile/enarpee", "username": "enarpee", "avatar": null, "contribution_count": 6, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2016-09-14", "published_at_date": "2016-09-14"}, {"review_id": 418290758, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r418290758-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "worth a visit , could be beautiful if kept clean and treated as a temple !!!", "text": "The Temple is dedicated to Lord shiva , the minute you entre the temple gate you do see the pashupati entrance from a distance, the walk from the entrance to the main tempe is really nice with interesting views and architecture. as you enter you see a big bull (nandi ) a bronze statue facing the entrance of the temple. The temple would be really an attraction if it was kept clean as i ket seeing people either spitting or there was cow dung. We could see loads of monkeys strolling the temple premises. So if you are on a short visit and have an evening to send you could do pashupati temple , its worth a visit.", "review_tip": null, "rating": 3, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2016-09-30"}, "reviewer": {"reviewer_id": "FDC162F730CB7CD51D178DF8CD3B2ADE", "name": "GlobetrotterGigi", "profile_link": "https://www.tripadvisor.com/Profile/GlobetrotterGigi", "username": "GlobetrotterGigi", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/09/34/5e/b2/globetrottergigi.jpg", "contribution_count": 63, "hometown": {"tripadvisor_entity_id": 294013, "location_name": "Abu Dhabi", "location_name_detailed": "Abu Dhabi, United Arab Emirates"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/f3/5a/fd/the-view-of-the-main.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/f3/5b/06/monkeys-monkeys-monkeys.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/f3/5b/18/the-nandi.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/f3/5b/28/the-entrance-where-you.jpg"], "created_at_date": "2016-09-14", "published_at_date": "2016-09-13"}, {"review_id": 417815490, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r417815490-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Good Darshan for devotees", "text": "The best time to visit the temple is when all the four directional doors of the Sanctum Sanctorum are open.  AS I understand the timings are 9 am to 11 am and 5 pm to 7 pm.  The visitors do not have to fear from pursuing Pandas (self proclaimed priests).", "review_tip": null, "rating": 4, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "business", "stay_date": "2016-09-30"}, "reviewer": {"reviewer_id": "A6510380A2511C7F55A938044A564098", "name": "SGR2014", "profile_link": "https://www.tripadvisor.com/Profile/SGR2014", "username": "SGR2014", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/18/45/c0/sgr2014.jpg", "contribution_count": 25, "hometown": {"tripadvisor_entity_id": 304554, "location_name": "Mumbai", "location_name_detailed": "Mumbai, India"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/f0/4d/de/temple.jpg"], "created_at_date": "2016-09-13", "published_at_date": "2016-09-13"}, {"review_id": 417790842, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r417790842-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Beautiful temple", "text": "This temple is worth to go! As a foreigner you have to pay 1000rupiees to get in (approx 8-9euros), but the temple area is beautiful! If you go there early you get to see cremation ceremonies on the banks of the river, sadhus (locals dedicating their life to meditation) and many many small temples. The biggest templeyoi can't unfortunately access unless you're a hindu, but you can see it from outside.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2016-08-31"}, "reviewer": {"reviewer_id": "492F3E748FD6000A93A5C86B4908863F", "name": "Shinax", "profile_link": "https://www.tripadvisor.com/Profile/Shinax", "username": "Shinax", "avatar": null, "contribution_count": 20, "hometown": {"tripadvisor_entity_id": 189934, "location_name": "Helsinki", "location_name_detailed": "Helsinki, Finland"}, "is_verified": false}, "images": [], "created_at_date": "2016-09-13", "published_at_date": "2016-09-12"}, {"review_id": 417754584, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r417754584-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Temple visit for blessings..", "text": "The temple is really beautiful and the Puja there is really engrossing. As all religious places, the place also lacks sanitation and cleanliness.. There is need to regulate the place to maintain cleanliness and safety of tourists visiting the area. ", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2016-09-30"}, "reviewer": {"reviewer_id": "EA1B252042322F901D85C4BFB1AB8DA6", "name": "GlobeTrotting649095", "profile_link": "https://www.tripadvisor.com/Profile/GlobeTrotting649095", "username": "GlobeTrotting649095", "avatar": null, "contribution_count": 5, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2016-09-13", "published_at_date": "2016-09-12"}, {"review_id": 417673018, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r417673018-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Very Spiritual Place", "text": "Don't miss evening Aarti. Life changing experience. Enjoy every second. During my stay in Kathmandu, I make sure that we go to evening Aarti and prayer.\nPeople are very nice and helpful there.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2016-06-30"}, "reviewer": {"reviewer_id": "055AE394B5A28EDF786E0DCD0D39FD9C", "name": "wiseguyoh", "profile_link": "https://www.tripadvisor.com/Profile/wiseguyoh", "username": "wiseguyoh", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/