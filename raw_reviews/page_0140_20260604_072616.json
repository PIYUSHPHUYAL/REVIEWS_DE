e}, "images": [], "created_at_date": "2015-01-31", "published_at_date": "2015-01-30"}, {"review_id": 251575053, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r251575053-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Must Visit place in Kathmandu", "text": "One of the oldest temples, this has a must visit charm. Once getting inside, you feel proud to be a Hindu and it is quite an unforgettable experience.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2014-06-30"}, "reviewer": {"reviewer_id": "17D8B79BE0C0DA8F448559E4A6C6953E", "name": "aa_india_1968", "profile_link": "https://www.tripadvisor.com/Profile/aa_india_1968", "username": "aa_india_1968", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/10/5a/16/04/aa-india-1968.jpg", "contribution_count": 154, "hometown": {"tripadvisor_entity_id": 304551, "location_name": "New Delhi", "location_name_detailed": "New Delhi, India"}, "is_verified": false}, "images": [], "created_at_date": "2015-01-29", "published_at_date": "2015-01-28"}, {"review_id": 251447121, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r251447121-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Must Visit In Kathmandu", "text": "I had a great experience. I would recommend everybody who is visiting kathmandu to go and visit Pashupatinath Temple.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "business", "stay_date": "2014-05-31"}, "reviewer": {"reviewer_id": "353474AA8376B19C6AD53DD580B24E04", "name": "Navkesh88", "profile_link": "https://www.tripadvisor.com/Profile/Navkesh88", "username": "Navkesh88", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/09/23/8e/c3/navkesh88.jpg", "contribution_count": 13, "hometown": {"tripadvisor_entity_id": 319726, "location_name": "Bhopal", "location_name_detailed": "Bhopal, India"}, "is_verified": false}, "images": [], "created_at_date": "2015-01-28", "published_at_date": "2015-01-28"}, {"review_id": 251443399, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r251443399-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Crowded, but a must visit", "text": "Pashupatinath temple is a must visit on the trip to Nepal, more so after having a harrowing day of flight travels. Our first point of visit, and thankfully with moderate crowd and sunny atmosphere after a rainy day the day before, this temple just makes you feel like home. Since only hindus are allowed inside, the foreigner crowd was cut out. The surroundings could have been maintained a bit better though.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2014-12-31"}, "reviewer": {"reviewer_id": "C1E81515DBCD12BCC513E2612B8E5DA8", "name": "AbhishekSahaEmory", "profile_link": "https://www.tripadvisor.com/Profile/AbhishekSahaEmory", "username": "AbhishekSahaEmory", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e4/2d/default-avatar-2020-48.jpg", "contribution_count": 197, "hometown": {"tripadvisor_entity_id": 304551, "location_name": "New Delhi", "location_name_detailed": "New Delhi, India"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/43/68/47/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/43/68/cd/pashupatinath-temple.jpg"], "created_at_date": "2015-01-28", "published_at_date": "2015-01-28"}, {"review_id": 251363208, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r251363208-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "interesting", "text": "pashupatinath leaves you with mixed feelings and many questions about life itself.... watching all the cremations on the riverbank does make you think about life itself. it's a very touching and interesting place and being one of the most important hindu temples it is a must visit.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2014-12-31"}, "reviewer": {"reviewer_id": "DC379E47B841031FFF3161A0FB28AEC6", "name": "AnitaDidi", "profile_link": "https://www.tripadvisor.com/Profile/AnitaDidi", "username": "AnitaDidi", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/42/e9/91/anitadidi.jpg", "contribution_count": 75, "hometown": {"tripadvisor_entity_id": 255060, "location_name": "Sydney", "location_name_detailed": "Sydney, Australia"}, "is_verified": false}, "images": [], "created_at_date": "2015-01-27", "published_at_date": "2015-01-27"}, {"review_id": 251310806, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r251310806-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "ONLY HINDU", "text": "Very Ancient temple located in Kathmandu city 4KM from Thamel market.\nPlease book your abhishek puja in advance 1 or 2 days prior.\n\n ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2015-01-31"}, "reviewer": {"reviewer_id": "55A82E16616990BBFF9B4CF0C23FDF5B", "name": "Aman B", "profile_link": "https://www.tripadvisor.com/Profile/ameerules", "username": "ameerules", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/eb/6d/default-avatar-2020-19.jpg", "contribution_count": 48, "hometown": {"tripadvisor_entity_id": 304551, "location_name": "New Delhi", "location_name_detailed": "New Delhi, India"}, "is_verified": false}, "images": [], "created_at_date": "2015-01-27", "published_at_date": "2015-01-27"}, {"review_id": 251289605, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r251289605-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Fascinating.", "text": "Our host took us to Pashupatinath Temple after our morning flight up to Mt. Everest.  It was quite a contrast.  Our host explained many of the ways and traditions associated with the cremation temple and many of the rituals associated with the life and death process and ceremony of Hindus.  Also had a couple wonderful conversations with some of the Sadu's at the Temple.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2014-05-31"}, "reviewer": {"reviewer_id": "CBDA96F9C1A73AA4B6527B4E9D6A099B", "name": "Babu957", "profile_link": "https://www.tripadvisor.com/Profile/Babu957", "username": "Babu957", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-s/02/89/b7/e5/babu957.jpg", "contribution_count": 378, "hometown": {"tripadvisor_entity_id": 60105, "location_name": "Monroe", "location_name_detailed": "Monroe, Wisconsin"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/42/44/33/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/42/44/3e/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/42/44/48/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/42/44/5a/pashupatinath-temple.jpg"], "created_at_date": "2015-01-27", "published_at_date": "2015-01-27"}, {"review_id": 251227966, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r251227966-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Not really worth it", "text": "If you really want to see dead bodies cremated, you should go here.  It is a cultural experience that is worth it if you are not used to Hindu culture.  That said, this temple is rather unwelcoming to tourists.  They will charge you 1000 nepali rupees (10$) for entrance, which is incredible expensive for the country of Nepal (and probably adds on to the other 40$ in entrance fees you paid for other places that day).  In addition, you won't even be allowed to enter the temple grounds of either of the two temples on the grounds.  So all you can really see is the river and the bodies burning by the river.  The rest of grounds are rather uninteresting or off limits.  Plus that, and there are a higher-than-average amount of touts and people looking to get money for photographs and blessings here, so be warned.", "review_tip": null, "rating": 2, "subratings": [], "like_count": 2, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2015-01-31"}, "reviewer": {"reviewer_id": "6D14AB5DEC40E4D86BDD39832A31F76E", "name": "David R", "profile_link": "https://www.tripadvisor.com/Profile/G5525PHdavidr", "username": "G5525PHdavidr", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e8/ea/default-avatar-2020-63.jpg", "contribution_count": 5, "hometown": {"tripadvisor_entity_id": 60745, "location_name": "Boston", "location_name_detailed": "Boston, Massachusetts"}, "is_verified": false}, "images": [], "created_at_date": "2015-01-27", "published_at_date": "2015-01-27"}, {"review_id": 251203045, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r251203045-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Real life, show respect to the things you see", "text": "That's not a show for tourist or something like that. It's the real life you will see there: Cremations tak eplace just in front of you. Show respect to the people that lost a friend/ relative/...! Unfortunately there where tourist groups, chatting and laughing while on the opposite bank of the river Bagmati the cerenomies took place.That was the most irritating thing to see.\n\nMany \"holy\" people around. Lot of things to see, to smell, ...\n\nA place you should have seen, when being in KTM.\n", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2015-01-31"}, "reviewer": {"reviewer_id": "9FF7A1AF888E2899ABC9CD44E008072E", "name": "bogi1995", "profile_link": "https://www.tripadvisor.com/Profile/bogi1995", "username": "bogi1995", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0d/72/5a/bf/bogi1995.jpg", "contribution_count": 356, "hometown": {"tripadvisor_entity_id": 1916827, "location_name": "Moehrendorf", "location_name_detailed": "Moehrendorf, Germany"}, "is_verified": false}, "images": [], "created_at_date": "2015-01-27", "published_at_date": "2015-01-26"}, {"review_id": 251199916, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r251199916-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Awesome but Crowded", "text": "A must go place for all the Hindu tourists and even others wont regret going. The architecture is very old but intact and beautiful. Better to go in the evenings when the premises are relatively empty to stroll around nicely and peacefully. Faith is redefined here.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "business", "stay_date": "2014-05-31"}, "reviewer": {"reviewer_id": "7735FA17CD3D5A0F2A0CD6BC31F2EAB6", "name": "kriti g", "profile_link": "https://www.tripadvisor.com/Profile/kritig24", "username": "kritig24", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e8/ea/default-avatar-2020-63.jpg", "contribution_count": 25, "hometown": {"tripadvisor_entity_id": 304554, "location_name": "Mumbai", "location_name_detailed": "Mumbai, India"}, "is_verified": false}, "images": [], "created_at_date": "2015-01-27", "published_at_date": "2015-01-26"}, {"review_id": 251185767, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r251185767-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Forty year relaionship with Kathmundhu", "text": "This is a Ghat, a Holy place,  worth a quiet visit to dwell on the Rituals of deaths that the Nepalese follow.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2014-11-30"}, "reviewer": {"reviewer_id": "C5AB84D824D06652C0BCD15CBEB838A9", "name": "Patricia G", "profile_link": "https://www.tripadvisor.com/Profile/259patriciag", "username": "259patriciag", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/de/5a/default-avatar-2020-36.jpg", "contribution_count": 6, "hometown": {"tripadvisor_entity_id": 285726, "location_name": "Fremantle", "location_name_detailed": "Fremantle, Australia"}, "is_verified": false}, "images": [], "created_at_date": "2015-01-26", "published_at_date": "2015-01-26"}, {"review_id": 250881932, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r250881932-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Life. Death. Believe. Ancient culture.", "text": "Even thou you can't get inside the sacred temple. But the cremation site will make you think about Life, Death and faith. Within one place you will see people pray to Hindu God for good thing in there life and by the river, they send the body of the departed back to god and everyone just watching like nothing happen. It's shown how this ancient culture think about life and death. Only a few place in this world can make you feel like this.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 2, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2015-01-31"}, "reviewer": {"reviewer_id": "E552B07DDDF683CF2CD8CAAD155D55A4", "name": "Sumet P", "profile_link": "https://www.tripadvisor.com/Profile/sumetp2014", "username": "sumetp2014", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/06/67/6e/3b/sumet-p.jpg", "contribution_count": 35, "hometown": {"tripadvisor_entity_id": 293916, "location_name": "Bangkok", "location_name_detailed": "Bangkok, Thailand"}, "is_verified": false}, "images": [], "created_at_date": "2015-01-25", "published_at_date": "2015-01-25"}, {"review_id": 250713164, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r250713164-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "FOR THE CURIOUS", "text": "For the morbidly curious.  This is where they cremate the dead.  There are about a dozen platforms for the cremations and no matter when you come some are in use.  If you are lucky, you'll see the ritual from beginning to almost the end when a body is brought in (washing the body on the stairs to the river, placing garlands and tumeric on the body, carrying to the funeral pyre and lighting the pyre).  The entire ceremony can take an hour or so - the cremating can take several hours (so an attendant stays with the pyre, adding wood until everything is ash, at which time it is brushed from the platform into the river).  The alley way/street leading to the area is lined with lepers begging and sadhus (not holy men here, just pan handlers), so it is not for the faint.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 2, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2014-10-31"}, "reviewer": {"reviewer_id": "ED9F59222A02B202FBB852752BD52692", "name": "rbthodge", "profile_link": "https://www.tripadvisor.com/Profile/rbthodge", "username": "rbthodge", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/03/fb/ed/0d/rbthodge.jpg", "contribution_count": 1856, "hometown": {"tripadvisor_entity_id": 181734, "location_name": "Whitby", "location_name_detailed": "Whitby, Canada"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/3e/91/a9/professional-pan-handlers.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/3e/91/aa/these-people-are-everywhere.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/3e/91/ab/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/3e/91/ac/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/3e/91/ad/preparing-the-deceased.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/3e/91/ae/the-cremation.jpg"], "created_at_date": "2015-01-23", "published_at_date": "2015-01-23"}, {"review_id": 250455065, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r250455065-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "A bit of a culture shock", "text": "This is where most of the Nepalese cremate their departed. If you're in for something traditional and cultural, this is a must-see!", "review_tip": null, "rating": 4, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2014-12-31"}, "reviewer": {"reviewer_id": "F8F8E61775F25FB48D545526EAF37249", "name": "Cielo R", "profile_link": "https://www.tripadvisor.com/Profile/cielor670", "username": "cielor670", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e7/3d/default-avatar-2020-55.jpg", "contribution_count": 11, "hometown": {"tripadvisor_entity_id": 298573, "location_name": "Manila", "location_name_detailed": "Manila, Philippines"}, "is_verified": false}, "images": [], "created_at_date": "2015-01-22", "published_at_date": "2015-01-22"}, {"review_id": 250431937, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r250431937-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Awesome when empty!!", "text": "Another place where you can just stroll along and sit for sometime. the famous Pashupatinath temple reminds you of how biutuful this place would have been when there was no construction around i.e. 100 years ago. Worth a visit at least once when you are in Kathmandu.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 2, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "business", "stay_date": "2015-01-31"}, "reviewer": {"reviewer_id": "E8BA48B111A455274B9F1E07844F1231", "name": "pratik_bhaumik", "profile_link": "https://www.tripadvisor.com/Profile/pratik_bhaumik", "username": "pratik_bhaumik", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e5/2b/default-avatar-2020-52.jpg", "contribution_count": 280, "hometown": {"tripadvisor_entity_id": 304551, "location_name": "New Delhi", "location_name_detailed": "New Delhi, India"}, "is_verified": false}, "images": [], "created_at_date": "2015-01-22", "published_at_date": "2015-01-21"}, {"review_id"