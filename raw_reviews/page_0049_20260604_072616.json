0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2018-06-30"}, "reviewer": {"reviewer_id": "47AB85BF2C99D674F333844636DC721C", "name": "betteradvisor", "profile_link": "https://www.tripadvisor.com/Profile/betteradvisor", "username": "betteradvisor", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/f0/9f/default-avatar-2020-16.jpg", "contribution_count": 138, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2018-06-03", "published_at_date": "2018-06-04"}, {"review_id": 584822202, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r584822202-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "A fascinating abode of Lord Shiva", "text": "Pashupatinath Temple is a fascinating abode of Lord Shiva, and is located in the lap of the Himalayas. The river Bagmati flows right behind the temple, where aarti is performed in the evenings. One is fascinated by the statue of the huge bull (Nandi) facing the Lord's shrine. Lord Pashupatinath has four faces facing the four directions, and one must circumambulate to have darshan of all the four faces. Lots of little shrines around the main shrine dot the temple complex. The PADT (Pashupatinath Area Development Trust) is managing and developing the temple complex and the surrounding areas. Some structures that were damaged during the earthquake are also being restored. An Adi Shankaracharya Mandir is also under renovation.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "business", "stay_date": "2018-05-31"}, "reviewer": {"reviewer_id": "9309380CD32BFF9D76C5F4E6E7F766AC", "name": "JoyOfTravellingIndia", "profile_link": "https://www.tripadvisor.com/Profile/JoyOfTravellingIndia", "username": "JoyOfTravellingIndia", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e8/ea/default-avatar-2020-63.jpg", "contribution_count": 77, "hometown": {"tripadvisor_entity_id": 304556, "location_name": "Chennai (Madras)", "location_name_detailed": "Chennai (Madras), India"}, "is_verified": false}, "images": [], "created_at_date": "2018-06-03", "published_at_date": "2018-06-03"}, {"review_id": 584740875, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r584740875-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Fascinating Place", "text": "We found this place to be the most fascinating in Kathmandu.  It probably helps greatly to have a guide to explain the place and what is going on as well as the significance of everything.  A guide found us near the ticket booth and he turned out to be great.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2018-05-31"}, "reviewer": {"reviewer_id": "AF7EC7557E6B0923CC3E5273DDD257D3", "name": "maasdad", "profile_link": "https://www.tripadvisor.com/Profile/maasdad", "username": "maasdad", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-f/01/2e/70/89/avatar010.jpg", "contribution_count": 18, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2018-06-03", "published_at_date": "2018-06-03"}, {"review_id": 584730822, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r584730822-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Har har Mahadev, Jai Bhole Nath", "text": "The place is very divine and always full of Lord Shiva's Bhakts. You can experience divine smell in air after coming here. The place is usually crowdy and you have to have some spare time for Darahans. You can also enjoy the Aarti done in evening. Local market is also there where you can buy lot of things for you and your loved ones.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2017-07-31"}, "reviewer": {"reviewer_id": "664032851D12EC25A4A93DD9CE14973D", "name": "ChanderShekharTyagi", "profile_link": "https://www.tripadvisor.com/Profile/ChanderShekharTyagi", "username": "ChanderShekharTyagi", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0a/bc/b7/f8/external-avatar.jpg", "contribution_count": 44, "hometown": {"tripadvisor_entity_id": 304551, "location_name": "New Delhi", "location_name_detailed": "New Delhi, India"}, "is_verified": false}, "images": [], "created_at_date": "2018-06-03", "published_at_date": "2018-06-03"}, {"review_id": 584703822, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r584703822-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Beautiful temple", "text": "Pushpatinath is a beautiful temple with clean surroundings. If you plan to go with family be prepared to walk a little till the temple. There are often long queues but also ways of cutting them! It is very close to the airport and hence a trip can be planned while coming or going to the airport. ", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "business", "stay_date": "2018-05-31"}, "reviewer": {"reviewer_id": "7CE932865A2BB5783EE4F087C4099742", "name": "time31traveller", "profile_link": "https://www.tripadvisor.com/Profile/time31traveller", "username": "time31traveller", "avatar": null, "contribution_count": 89, "hometown": {"tripadvisor_entity_id": 304551, "location_name": "New Delhi", "location_name_detailed": "New Delhi, 