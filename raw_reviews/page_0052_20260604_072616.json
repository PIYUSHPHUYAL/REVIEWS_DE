ted_at_date": "2018-04-30", "published_at_date": "2018-04-30"}, {"review_id": 576321580, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r576321580-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Not for the faint hearted", "text": "WOW. This place is quite something. Many funerals happening along the river bed. Incredible to watch from the other side of the river respectfully, can be quite difficult to watch people grieve say goodbye to their loved ones but equally facinating to see the traditions of the faith. Worth a visit but just watch out for the heat and the smells of the burning corpses.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2018-04-30"}, "reviewer": {"reviewer_id": "46798DC15AFADA93C5C0BC5660CC65FB", "name": "Rebecca", "profile_link": "https://www.tripadvisor.com/Profile/Bexandco", "username": "Bexandco", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/11/60/1b/9c/bexandco.jpg", "contribution_count": 553, "hometown": {"tripadvisor_entity_id": 187052, "location_name": "Greater Manchester", "location_name_detailed": "Greater Manchester, United Kingdom"}, "is_verified": false}, "images": [], "created_at_date": "2018-04-28", "published_at_date": "2018-04-29"}, {"review_id": 576067790, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r576067790-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Very famed temple in Nepal", "text": "Pashupati Nath is a very famed temple of Nepal. Our PM Narendra Modi has visited this temple when on official visit to Nepal.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type"