e}, "images": [], "created_at_date": "2011-11-13", "published_at_date": "2011-11-13"}, {"review_id": 120526887, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r120526887-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Overwhelming sights and smells", "text": "WAtching cremations was a surreal experience, but smelling it made the experience terribly intense. It was very interesting to learn about the rituals involved in Hindu funerals. There were a number of families carrying out funeral rites while we were there, which gave us an intimate perspective of how Hindu culture deals with the life cycle. We had an excellent guide.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 2, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2011-11-30"}, "reviewer": {"reviewer_id": "3F1007E9190B18458DA0B7DB61928AA1", "name": "Pollyanna-Ist", "profile_link": "https://www.tripadvisor.com/Profile/Pollyanna-Ist", "username": "Pollyanna-Ist", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-s/01/a9/c9/af/pollyanna-ist.jpg", "contribution_count": 52, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2011-11-13", "published_at_date": "2011-11-13"}, {"review_id": 120524991, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r120524991-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "What a place!!!", "text": "A must see, if you're visiting Kathmandu. You will never forget it, and your senses will be overwhelmed in every possible way. Appart from the burning cadavers on the river bank, and the temples, the colourful people, the school with its windows overlooking the burning of the dead (what a lesson in life for those children!), expect chaos, and being pestered by woud be guides. Shoo them off politely or less politely if the become really pestering. Enjoy!", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2010-12-31"}, "reviewer": {"reviewer_id": "4298465E6A638807D96070DF595E0BFC", "name": "yakshaver", "profile_link": "https://www.tripadvisor.com/Profile/yakshaver", "username": "yakshaver", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-s/01/fa/9c/d8/yakshaver.jpg", "contribution_count": 412, "hometown": {"tripadvisor_entity_id": 255060, "location_name": "Sydney", "location_name_detailed": "Sydney, Australia"}, "is_verified": false}, "images": [], "created_at_date": "2011-11-13", "published_at_date": "2011-11-13"}, {"review_id": 120489395, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r120489395-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Beware the tourist guide hustlers", "text": "Interesting, but we got talking to a local who then demanded US$30 for his 45 minute talk. We had neither engaged him nor had we discussed a fee.  Naturally, we were happy to make a contribution but he DEMANDED US$30.  We gave him US$15.  He wasn't happy!", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2011-11-30"}, "reviewer": {"reviewer_id": "AA58ADEC3E6B6E3D2E2AAD7130C8239B", "name": "Mike W", "profile_link": "https://www.tripadvisor.com/Profile/Manama_Mike", "username": "Manama_Mike", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/14/f2/2a/46/mike-w.jpg", "contribution_count": 37, "hometown": {"tripadvisor_entity_id": 1902005, "location_name": "Mexilhoeira Grande", "location_name_detailed": "Mexilhoeira Grande, Portugal"}, "is_verified": false}, "ima