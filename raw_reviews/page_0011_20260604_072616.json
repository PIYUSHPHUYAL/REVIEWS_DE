response": null, "trip": {"trip_type": "family", "stay_date": "2020-01-31"}, "reviewer": {"reviewer_id": "96A965BC8F5EB13D55CA9B264D9E04E0", "name": "Yash Mittal", "profile_link": "https://www.tripadvisor.com/Profile/yashmittal_SF", "username": "yashmittal_SF", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1b/45/e2/9b/avatar.jpg", "contribution_count": 31, "hometown": {"tripadvisor_entity_id": 304551, "location_name": "New Delhi", "location_name_detailed": "New Delhi, India"}, "is_verified": false}, "images": [], "created_at_date": "2020-04-20", "published_at_date": "2020-04-20"}, {"review_id": 752756929, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r752756929-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "The Biggest Hindu Temple in Nepal", "text": "This temple dedicated to Lord Shiva is perhaps the biggest Hindu Temple in Nepal. Within the city limits of the city of Kathmandu, the temple is said to attract devotees in large numbers throughout the year from all parts of the world, particularly from India. Some say the this temple dates back to 400 BC. It is UNESCO approved heritage place.\nSituated on the banks of the Bagamathi River, it was built in the 5th Century .\nThe Main deity is to be seen through FOUR entrances , narrow . Lord Shiva's Face is seen on four sides of the Lingam besides on the top. It is only one of its kind. \nThe temple could be still better kept. Car parking is vast but dirty.\nThere is no fee for entrance to the temple.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": null, "stay_date": "2019-08-31"}, "reviewer": {"reviewer_id": "E615E0E89369E5212CF3690A7116A9FD", "name": "Sivakumar V", "profile_link": "https://www.tripadvisor.com/Profile/sivakumarv2017", "username": "sivakumarv2017", "avatar": "https://dynami