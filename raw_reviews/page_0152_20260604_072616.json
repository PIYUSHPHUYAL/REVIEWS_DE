ull, "trip": {"trip_type": "friends", "stay_date": "2014-09-30"}, "reviewer": {"reviewer_id": "050B1035BCCBD056F378B3F8957C0E26", "name": "MedievalTours", "profile_link": "https://www.tripadvisor.com/Profile/MedievalTours", "username": "MedievalTours", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e8/5b/default-avatar-2020-61.jpg", "contribution_count": 5, "hometown": {"tripadvisor_entity_id": 293890, "location_name": "Kathmandu", "location_name_detailed": "Kathmandu, Nepal"}, "is_verified": false}, "images": [], "created_at_date": "2014-09-18", "published_at_date": "2014-09-18"}, {"review_id": 229404651, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r229404651-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "WORLD HERITAGE SITE ....JUST GOO", "text": "one of the most important holy place for the HINDUS around the world ..\n  the place will give u such a divine feeling....amazing ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2014-08-31"}, "reviewer": {"reviewer_id": "D277B35F62BC7326C0C0F9CC60E41C9A", "name": "suzal99", "profile_link": "https://www.tripadvisor.com/Profile/suzal99", "username": "suzal99", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/06/49/3e/79/suzal99.jpg", "contribution_count": 5, "hometown": {"tripadvisor_entity_id": 304551, "location_name": "New Delhi", "location_name_detailed": "New Delhi, India"}, "is_verified": false}, "images": [], "created_at_date": "2014-09-17", "published_at_date": "2014-09-17"}, {"review_id": 229385714, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r229385714-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Magnificent", "text": "One of the oldest Shiva temples in the country, this has four faces of Shiva in the main temple. There are four sides to the temple and one can get to see the four faces. The architecture is very beautiful. There is an evening aarti which is very nice and also an aarti best to the bagmati river behind the temple in the evening. If one wants to see the river aarti, one should go to the side of the river and not be in the temple premises as they close the temple compound at 7 and the aarti is still on. One has to be careful of belongings as there are monkeys in the compound.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2014-09-30"}, "reviewer": {"reviewer_id": "DA312115926AFE32C530EDA84AD8584F", "name": "rbsing", "profile_link": "https://www.tripadvisor.com/Profile/rbsing", "username": "rbsing", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/ec/3d/default-avatar-2020-1.jpg", "contribution_count": 140, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2014-09-17", "published_at_date": "2014-09-17"}, {"review_id": 229227830, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r229227830-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Unique", "text": "Spend time, take it to let the impressions sink. On the one side cremations are taking place and the other women and children bath in this river. \n\nThe long walk up the stairs is worth the forest on the top. You can wander off alone and let the impressions sink. Small cafe on top of the climb is much appreciated for a quick coke. Wish I had more time to stay. \n\nDefinitely a must go.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": null, "stay_date": null}, "reviewer": {"reviewer_id": "109260296F913248E462A575CEEDD3C9", "name": "WKne", "profile_link": "https://www.tripadvisor.com/Profile/WKne", "username": "WKne", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e3/6a/default-avatar-2020-47.jpg", "contribution_count": 25, "hometown": {"tripadvisor_entity_id": 295424, "location_name": "Dubai", "location_name_detailed": "Dubai, United Arab Emirates"}, "is_verified": false}, "images": [], "created_at_date": "2014-09-16", "published_at_date": "2014-09-16"}, {"review_id": 229161521, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r229161521-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Divine feel", "text": "What a wonderful place , makes a divine feel every time i m there...really a good place to feel heaven", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2013-10-31"}, "reviewer": {"reviewer_id": "42479DE132A561AA508626EE4CD65B6A", "name": "Bibek K", "profile_link": "https://www.tripadvisor.com/Profile/454bibekk", "username": "454bibekk", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/f1/b8/default-avatar-2020-22.jpg", "contribution_count": 2, "hometown": {"tripadvisor_entity_id": 293890, "location_name": "Kathmandu", "location_name_detailed": "Kathmandu, Nepal"}, "is_verified": false}, "images": [], "created_at_date": "2014-09-16", "published_at_date": "2014-09-16"}, {"review_id": 229150132, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r229150132-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "\"Shunya\"", "text": "It is one of the most sacred places for Hindus located on the banks of Bagmati. Kathmandu's main crematorium is in its backyard. \n\nI got a chance to be present at the aarti performed in the evening (around 19:00 hrs) on the banks of bagmati. That experience was divine...standing at feet of Lord Shiva - God of destruction or transformation, witnessing the majestic aarti being performed at the other side of the bank and dead bodies being cremated on one side. I felt like I was witnessing the separation of body and soul with my bare eyes. Mind went blank, first time in life i felt myself incomplete shunya.\n\nInformation & Warnings:\n1) Temple gates are closed by 18:30 hrs\n2) You will find a lot child beggars....try not to promote that\n3) Large monkey population....eatables may be snatched fro your hand\n4) Soft hearted people and small children may not be taken for aarti or in the backyard near the bank of bagmati.....scene of cremation of dead bodies may cast a deep impact on the them.\n\n", "review_tip": null, "rating": 4, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "business", "stay_date": "2014-09-30"}, "reviewer": {"reviewer_id": "BCD842B8FC3CFE7628E49D32F55D98EE", "name": "BA0907", "profile_link": "https://www.tripadvisor.com/Profile/BA0907", "username": "BA0907", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-s/02/6b/0d/59/bhavyaanand.jpg", "contribution_count": 26, "hometown": {"tripadvisor_entity_id": 297615, "location_name": "Gurugram (Gurgaon)", "location_name_detailed": "Gurugram (Gurgaon), India"}, "is_verified": false}, "images": [], "created_at_date": "2014-09-16", "published_at_date": "2014-09-16"}, {"review_id": 228993880, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r228993880-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Amazing!!!", "text": "This is one of the thing's you MUSTvisit once in Kathmandu. This complex of temples, shrines and cremation ghats...You woud feel it hard...An experience for life. Beautiful architecture.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2014-08-31"}, "reviewer": {"reviewer_id": "2D88EB417C4C0BB76078765208CEA782", "name": "RuiPedroSimoes", "profile_link": "https://www.tripadvisor.com/Profile/RuiPedroSimoes", "username": "RuiPedroSimoes", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/04/8e/93/21/ruipedrosimoes.jpg", "contribution_count": 95, "hometown": {"tripadvisor_entity_id": 230085, "location_name": "Leiria", "location_name_detailed": "Leiria, Portugal"}, "is_verified": false}, "images": [], "created_at_date": "2014-09-15", "published_at_date": "2014-09-15"}, {"review_id": 228939009, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r228939009-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Ancient temple", "text": "The oldest temple and market,the architecture of the site and buildings,the feel of our ancestors. The stunning carvings on the buildings,doors,entrances,courtyards of palaces", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2014-09-30"}, "reviewer": {"reviewer_id": "E15A66DA29D63E5A292A079F858FC547", "name": "kubair R", "profile_link": "https://www.tripadvisor.com/Profile/Nepal14", "username": "Nepal14", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e8/91/default-avatar-2020-62.jpg", "contribution_count": 3, "hometown": {"tripadvisor_entity_id": 255100, "location_name": "Melbourne", "location_name_detailed": "Melbourne, Australia"}, "is_verified": false}, "images": [], "created_at_date": "2014-09-15", "published_at_date": "2014-09-15"}, {"review_id": 228563886, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r228563886-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Jai Bhole Nath", "text": "Very Nice Place..... Must Visit this place of Lord Shiva. should do parikrama over there. excellent experience", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2014-08-31"}, "reviewer": {"reviewer_id": "00DF6DF5B05EFBFE0D990AE3EBE81DB5", "name": "Narang1985", "profile_link": "https://www.tripadvisor.com/Profile/Narang1985", "username": "Narang1985", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e8/91/default-avatar-2020-62.jpg", "contribution_count": 2, "hometown": {"tripadvisor_entity_id": 304554, "location_name": "Mumbai", "location_name_detailed": "Mumbai, India"}, "is_verified": false}, "images": [], "created_at_date": "2014-09-13", "published_at_date": "2014-09-12"}, {"review_id": 228514431, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r228514431-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "DIVINE PLACE!!!", "text": "What a feel amazingly Devine and serene place want to visit many more times. The four side darshana make it unique. There are thousands of shivlings placed in certain order which one touches with both hands and it gives a good feel.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": null, "stay_date": "2014-08-31"}, "reviewer": {"reviewer_id": "74D7CCBD21B4B09723425CF460EA3ADF", "name": "nancy d", "profile_link": "https://www.tripadvisor.com/Profile/999nancyd", "username": "999nancyd", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e9/60/default-avatar-2020-64.jpg", "contribution_count": 8, "hometown": {"tripadvisor_entity_id": 186306, "location_name": "St. Albans", "location_name_detailed": "St. Albans, United Kingdom"}, "is_verified": false}, "images": [], "created_at_date": "2014-09-12", "published_at_date": "2014-09-12"}, {"review_id": 228469409, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r228469409-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Overwhelming Experience! Must visit!", "text": "I reached at 6 PM to witness the evening aarti that takes place. The architecture was awesome. The monkeys were really playful. One female monkey snatched the prasad packet from my hand and then when I pulled it back from her, she pulled my stole. It was quite a show for all those present there. So keep fruits and other eatables out of the reach of monkeys. \n\nBehind the Pashupatinath temple, next to the river, there were around 7 cremations going on. The smoke from the cremation was overwhelming. I stood watching the cremation and the relatives of the deceased who have come to bid adieu to the departed soul. The friends and relatives of the deceased were so engrossed in their mobile phones and chit chatting with others, it made me think that there is no use of living life thinking of others. Our life is our own. No one cares once we are dead. The visit to this temple made me realise that life is just one and this life is yours, live it to the fullest without a care in the world.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2014-08-31"}, "reviewer": {"reviewer_id": "9D2EDBDDA1F94139C2DC6EF781B2825B", "name": "Smruti S", "profile_link": "https://www.tripadvisor.com/Profile/SmrutiS_12", "username": "SmrutiS_12", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/17/b5/b7/3b/caption.jpg", "contribution_count": 164, "hometown": {"tripadvisor_entity_id": 1940497, "location_name": "Muscat", "location_name_detailed": "Muscat, Oman"}, "is_verified": false}, "images": [], "created_at_date": "2014-09-12", "published_at_date": "2014-09-12"}, {"review_id": 228425982, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r228425982-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "a must visit", "text": "It's a very sacred site to the Hindu. Here u get to see am amazing display of faith of the Hindus. I'm amazed by the ceremony the faithful gone through to send their loved ones on their last journey", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2014-09-30"}, "reviewer": {"reviewer_id": "7A9EFB7DD1FC352B5B600C3862766BCB", "name": "Whitebells666", "profile_link": "https://www.tripadvisor.com/Profile/Whitebells666", "username": "Whitebells666", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0d/d8/00/55/greenpebbles.jpg", "contribution_count": 412, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2014-09-12", "published_at_date": "2014-09-12"}, {"review_id": 228240597, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r228240597-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "ऊँJai Bhole nathऊँ", "text": "Very religious very good place in Kathmandu. It's a place filled with tourists, devotees , sadhoos or pandits. It's the biggest shive temple in Aisa. There is a river called bagmati in which cremation r done. It's a very beautiful place & clicking photographs r not allowed. There's a tight security in temple. If anyone wants to rest his mind that person can go there.", "review_tip": nu