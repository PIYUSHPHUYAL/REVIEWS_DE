ation_name_detailed": "Dunsborough, Australia"}, "is_verified": false}, "images": [], "created_at_date": "2018-04-26", "published_at_date": "2018-04-26"}, {"review_id": 575572067, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r575572067-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Spritual Place", "text": "Pashupati Nath is one of the highly religious places in the world. The view from the temple hills is just breathtaking.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": null, "stay_date": "2017-08-31"}, "reviewer": {"reviewer_id": "7D8B3DC6DF242217837289475D4EB5E6", "name": "Kashmir R", "profile_link": "https://www.tripadvisor.com/Profile/kashmirr2017", "username": "kashmirr2017", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/11/69/71/50/kashmirgalway.jpg", "contribution_count": 5, "hometown": {"tripadvisor_entity_id": 212530, "location_name": "Blessington", "location_name_detailed": "Blessington, Ireland"}, "is_verified": false}, "images": [], "created_at_date": "2018-04-25", "published_at_date": "2018-04-25"}, {"review_id": 575399432, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r575399432-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Serene", "text": "The pashupati Nath temple is simply amazing. The minute you enter inside you feel very peaceful. Best sight is a few monkeys sometimes.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2017-12-31"}, "reviewer": {"reviewer_id": "A58BFDE6255FC33727A27247831EC4C8", "name": "Bharti L", "profile_link": "https://www.tripadvisor.com/Profile/BhartiL", "user