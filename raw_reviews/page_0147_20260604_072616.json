type": "couples", "stay_date": "2014-07-31"}, "reviewer": {"reviewer_id": "CB991D9D2DFC28B26C88E4A8A68DCFC0", "name": "Sudha R", "profile_link": "https://www.tripadvisor.com/Profile/543sudhar", "username": "543sudhar", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/f2/7a/default-avatar-2020-25.jpg", "contribution_count": 2, "hometown": {"tripadvisor_entity_id": 42345, "location_name": "Jackson", "location_name_detailed": "Jackson, Michigan"}, "is_verified": false}, "images": [], "created_at_date": "2014-11-08", "published_at_date": "2014-11-08"}, {"review_id": 238705580, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r238705580-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "I could not get inside the temple.", "text": "One Thousand Rupees to go into the complex, but only Hindus could enter the temples. I believe there is much cultural significance here but if I am to pay for the restoration of this temple complex as least I should be able to take a look. There was a language problem at the gate, and the whole thing put me off the visit. Still a nice place to wander about inside and outside the gates. And even though I had a problem I would still recommend a visit. At least you will be prepared for the strange \"pay to not see the temples\" thing.", "review_tip": null, "rating": 3, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2014-11-30"}, "reviewer": {"reviewer_id": "B480888FD282B4F3682A44EF93392142", "name": "Robert L", "profile_link": "https://www.tripadvisor.com/Profile/jroberto", "username": "jroberto", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/06/1a/50/da/jroberto.jpg", "contribution_count": 698, "hometown": {"tripadvisor_entity_id": 32859, "location_name": "Pasadena", "location_name_detailed": "Pasadena, California"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/06/dd/de/d1/cows-everywhere-and-this.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/06/dd/de/ea/holy-pidgions-and-cows.jpg"], "created_at_date": "2014-11-08", "published_at_date": "2014-11-07"}, {"review_id": 238704251, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r238704251-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Life and Death", "text": "An amazing place. where you see several temples ans sharine including Pasupatinath. The holy river Bagmati , Sadhu and creemiation (After  death activities) are attractions. I highly recommend one to visit there to study about hinduism.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2014-11-30"}, "reviewer": {"reviewer_id": "A48799BB01E9E8653CBD420472234590", "name": "ramad v", "profile_link": "https://www.tripadvisor.com/Profile/ramadv", "username": "ramadv", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/de/0a/default-avatar-2020-35.jpg", "contribution_count": 7, "hometown": {"tripadvisor_entity_id": 293890, "location_name": "Kathmandu", "location_name_detailed": "Kathmandu, Nepal"}, "is_verified": false}, "images": [], "created_at_date": "2014-11-08", "published_at_date": "2014-11-07"}, {"review_id": 238579628, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r238579628-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Interesting", "text": "If you know little about Hindu cultural, you might want to go see the cremation process there, It's a bit shocking but ineresting.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2014-10-31"}, "reviewer": {"reviewer_id": "C58CC443E2883FA121E968B6E79CD8EE", "name": "HanyChahine", "profile_link": "https://www.tripadvisor.com/Profile/HanyChahine", "username": "HanyChahine", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/05/fc/88/72/hanychahine.jpg", "contribution_count": 33, "hometown": {"tripadvisor_entity_id": 294201, "location_name": "Cairo", "location_name_detailed": "Cairo, Egypt"}, "is_verified": false}, "images": [], "created_at_date": "2014-11-07", "published_at_date": "2014-11-07"}, {"review_id": 238416531, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r238416531-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "An emotional and tutorial place", "text": "Where in the west burials are private here Pashupatinath you learn the opposite. People are together with their lost love ones until the very end and it makes you think. One is with the lost in every step of the way, there are many rituals before cremating and after the cremation.Every body is welcomed to bid farewell . The small private ritual masters sitting by the riverside and the many Sadhus around is an extra dimension . All though a very different culture to gasp this place is powerful and takes you into many thoughts however difficult to explain. Read and learn before you visit the place it is more rewarding . This is one of the musts while in Kathmandu and you will not regret it .", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2014-10-31"}, "reviewer": {"reviewer_id": "84BF0B88E390D5CC1F04E52D67D95EF2", "name": "sundaysytmen", "profile_link": "https://www.tripadvisor.com/Profile/sundaysytmen", "username": "sundaysytmen", "avatar": "