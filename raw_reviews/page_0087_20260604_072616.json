[], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2017-01-31"}, "reviewer": {"reviewer_id": "A5E1463BF8E22A024D15E1354A7ECD2F", "name": "vijayakumarindain", "profile_link": "https://www.tripadvisor.com/Profile/vijayakumarindain", "username": "vijayakumarindain", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e8/91/default-avatar-2020-62.jpg", "contribution_count": 3, "hometown": {"tripadvisor_entity_id": 298570, "location_name": "Kuala Lumpur", "location_name_detailed": "Kuala Lumpur, Malaysia"}, "is_verified": false}, "images": [], "created_at_date": "2017-02-26", "published_at_date": "2017-02-26"}, {"review_id": 462865559, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r462865559-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Earthly yet Cosmic", "text": "There are crowds, there is filth, and there is death...but there is also life, vibrant in divinity, ritual, and faith. Being at Pashupati is an intense experience that truly revives your spirit and physical senses. The actual temple complex may not be as large and wide-spread as many of the temples in India and east asia, but it fills your mind. You emerge anew.\n\nThe government and the administrative board really needs to pull up its socks when it comes to the general upkeep and maintenance of the temple grounds. This important centre of Hindu divinity deserves a lot better.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 4, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2016-12-31"}, "reviewer": {"reviewer_id": "C4425108289A76D421B2ABEA59796A85", "name": "Ace A", "profile_link": "https://www.tripadvisor.com/Profile/AceAuteur", "username": "AceAuteur", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/25/28/a6/aceauteur.jpg", "contribution_count": 36, "hometown": {"tripadvisor_entity_id": 28970, "location_name": "Washington DC", "location_name_detailed": "Washington DC, District of Columbia"}, "is_verified": false}, "images": [], "created_at_date": "2017-02-26", "published_at_date": "2017-02-26"}, {"review_id": 462818993, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r462818993-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Culturally fascinating ", "text": "Located on the east side of Kathmandu, Pashupati̇̄nāth is a 50 minute walk from the centre of a 15 minute taxi. \nWe were stopped at the entrance and as foreigners had to pay 1,000rupee (about £8) for a ticket each. \n\nIt wasn't clear where we were allowed to go but a man from the ticket office appeared next to us and engaged in conversation asking where we were from etc. He explained the cultures surrounding the cremation and then beckoned us to the other side of the bridge. He spent about 90 minutes taking us round and it was unclear if he was a guide, included with the ticket or just a friendly local. He was very patient and there was no rush and we bought him a drink at the top of the temple. I tipped him (I thought generously!) at the end but he made it clear he wasn't happy with the amount given which was quite embarrassing; he latched onto us we didn't ask him to! \n\nAside from this the temple was absolutely fascinating and it's little wonder this is a UNESCO site. ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2017-02-28"}, "reviewer": {"reviewer_id": "585F6D847E5EE2AB367AE5CF2657AB0F", "name": "chris0241", "profile_link": "https://www.tripadvisor.com/Profile/chris0241", "username": "chris0241", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/2e/77/0b/de/caption.jpg", "contribution_count": 195, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2017-02-26", "published_at_date": "2017-02-26"}, {"review_id": 462739343, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r462739343-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Must see! ", "text": "Prepare yourself and possibly eat before you arrive here. It is a must see. It is one step closer to understanding the Hindu rituals and coming face to face to there ceremony of death through cremation. I would recommend this one over the one in Varanasi! It is absolutely intriguing. Make sure you are respectful.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2017-02-28"}, "reviewer": {"reviewer_id": "BBAC9D341BEB8B2B330E39C71B629D57", "name": "Rebeca D", "profile_link": "https://www.tripadvisor.com/Profile/RebecaD239", "username": "RebecaD239", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e9/bb/default-avatar-2020-65.jpg", "contribution_count": 26, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2017-02-25", "published_at_date": "2017-02-26"}, {"review_id": 462738812, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r462738812-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Very Rich Culture", "text": "I was amazed my their rich and welcoming culture. Just around this  temple is whole another world. you would have plenty to learn about culture based on Hinduism.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_