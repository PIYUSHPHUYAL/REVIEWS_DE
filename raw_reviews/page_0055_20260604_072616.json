"is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2018-03-31"}, "reviewer": {"reviewer_id": "8CCC7E5333217687F34D38DAE8533EEA", "name": "Martin N", "profile_link": "https://www.tripadvisor.com/Profile/martinn978", "username": "martinn978", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/05/9e/36/5a/martin-n.jpg", "contribution_count": 184, "hometown": {"tripadvisor_entity_id": 187056, "location_name": "Maidstone", "location_name_detailed": "Maidstone, United Kingdom"}, "is_verified": false}, "images": [], "created_at_date": "2018-04-02", "published_at_date": "2018-04-03"}, {"review_id": 570362776, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r570362776-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Its Iconic and Religious", "text": "Pashupati Nath Temple shows the image of God Shiva, the Hindus people have a lot respect and pray to god shiva .", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2018-03-31"}, "reviewer": {"reviewer_id": "C9560B4BC403BF7EC84442B48855378C", "name": "A S", "profile_link": "https://www.tripadvisor.com/Profile/O9473JJas", "username": "O9473JJas", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/de/e7/default-avatar-2020-37.jpg", "contribution_count": 18, "hometown": {"tripadvisor_entity_id": 2407100, "location_name": "Bharatpur", "location_name_detailed": "Bharatpur, Nepal"}, "is_verified": false}, "images": [], "created_at_date": "2018-04-02", "published_at_date": "2018-04-02"}, {"review_id": 570328626, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r570328626-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Not for the faint hearted", "text": "UNESCO heritage site and well deserved. It is a complex of Hindu temples mostly unaffected by tourists. Sadhu and fakirs happily do their things though you can spot the ones who has their eyes on tourist $. \nAs you walk further upstream, you can see rituals by family members preparing to cremate the body of their loved ones. We saw several of these simultaneously at different stages of their rituals. Respectfully we all stood across the small river to observe this. Not for the faint-hearted.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2018-02-28"}, "reviewer": {"reviewer_id": "C97CCB90838715FA4BFD733B3BC560A5", "name": "LK L", "profile_link": "https://www.tripadvisor.com/Profile/252lkl", "username": "252lkl", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/de/e7/default-avatar-2020-37.jpg", "contribution_count": 18, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2018-04-02", "published_at_date": "2018-04-02"}, {"review_id": 570245811, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r570245811-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Somber But Inspiring- Don't Miss It!", "text": "This was a very interesting and informative place to visit to understand the history and the details of the services that take place their. It gives you great insight into the spirituality of the locals and was very unique. The buildings and architecture are amazing, great for people watching and I loved seeing the monkeys roaming freely about. Worth the visit!", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2018-04-30"}, "reviewer": {"reviewer_id": "F7A43EE3968C2FB3EE56A147C62EB8C2", "name": "tripdude541", "profile_link": "https://www.tripadvisor.com/Profile/tripdude541", "username": "tripdude541", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/06/9a/2b/21/tripdude541.jpg", "contribution_count": 248, "hometown": {"tripadvisor_entity_id": 52024, "location_name": "Portland", "location_name_detailed": "Portland, Oregon"}, "is_verified": false}, "images": [], "created_at_date": "2018-04-01", "published_at_date": "2018-04-02"}, {"review_id": 570213406, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r570213406-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Reverant place", "text": "This important site is a must visit to get a real feel of religious life in Nepal.  This is where bodies are cremated so is rather somber but fascinating.  Lots of amazing small and large temples on the grounds which are very extensive.  ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "business", "stay_date": "2018-03-31"}, "reviewer": {"reviewer_id": "A0C9A33070A5C57E3517B1F9F489F437", "name": "orchidist", "profile_link": "https://www.tripadvisor.com/Profile/orchidist", "username": "orchidist", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/08/54/36/50/orchidist.jpg", "contribution_count": 136, "hometown": {"tripadvisor_entity_id": 52024, "location_name": "Portland", "location_name_detailed": "Portland, Oregon"}, "is_verified": false}, "images": [], "created_at_date": "2018-04-01", "published_at_date": "2018-04-02"}, {"review_id": 570075535, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r570075535-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Fascinating cultural experience", "text": "This complex cost 1000 rupees ($10) which is excellent for a world heritage site. The money goes to good use for repairs from the earthquake a few years ago. There are local guides around the ticket booth. Our guide was awesome, charging 500 rupees ($5) per person for an hour tour. His explaination of the culture and customs was invaluable. The main temple only Hindus can enter but you can get a glimpse inside through the gate. However the rest of the complex is open for us. We went down by the river to see the open creamations. There are usually about 35 creamations a day. Crossing over the river we went to see the Holy men and where they live. They are glad to give you a blessing and have a photo taken with them, but expect to tip. On site is also Mother Teresa’s home for the poor.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2018-04-30"}, "reviewer": {"reviewer_id": "F5DE4E9C9F7E9E3B61FF254D4448740C", "name": "DoctorDerm1", "profile_link": "https://www.tripadvisor.com/Profile/DoctorDerm1", "username": "DoctorDerm1", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/17/28/1d/81/doctorderm1.jpg", "contribution_count": 268, "hometown": {"tripadvisor_entity_id": 34748, "location_name": "Winter Springs", "location_name_detailed": "Winter Springs, Florida"}, "is_verified": false}, "images": [], "created_at_date": "2018-04-01", "published_at_date": "2018-04-02"}, {"review_id": 570027386, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r570027386-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Hindu cremation ", "text": "A must see. Something you won’t see many places in the world. Close to the airport.\nFunerals normally take place in the morning but continue to afternoon and are everyday.\n1,000 rupees for tourists to enter ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 2, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2018-04-30"}, "reviewer": {"reviewer_id": "A75679FF6FF305316EEA40E9FC86F58A", "name": "Ecotraveller2015", "profile_link": "https://www.tripadvisor.com/Profile/Ecotraveller2015", "username": "Ecotraveller2015", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-f/01/2e/70/60/avatar038.jpg", "contribution_count": 23, "hometown": {"tripadvisor_entity_id": 295424, "location_name": "Dubai", "location_name_detailed": "Dubai, United Arab Emirates"}, "is_verified": false}, "images": [], "created_at_date": "2018-04-01", "published_at_date": "2018-04-01"}, {"review_id": 569918562, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r569918562-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Good but only hindus are allowed", "text": "This place is a huge temple and cremation ground. Many fierce barking dogs are there. Some saints and local people see you that you are not expected.  Only hindus can enter to the temple,", "review_tip": null, "rating": 3, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2017-04-30"}, "reviewer": {"reviewer_id": "0192C03DE747D97A224412BD2A896BED", "name": "Dr. Ziauddin Ahmed", "profile_link": "https://www.tripadvisor.com/Profile/JoyShurjo", "username": "JoyShurjo", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/29/bf/8e/5b/joyshurjo.jpg", "contribution_count": 2111, "hometown": {"tripadvisor_entity_id": 293936, "location_name": "Dhaka City", "location_name_detailed": "Dhaka City, Bangladesh"}, "is_verified": false}, "images": [], "created_at_date": "2018-03-31", "published_at_date": "2018-04-01"}], "rating_di