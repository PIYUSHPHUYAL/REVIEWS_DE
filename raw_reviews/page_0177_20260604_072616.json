bratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2013-04-30"}, "reviewer": {"reviewer_id": "9B337D7C7EC044EB0478F1540F9D3919", "name": "Brad G", "profile_link": "https://www.tripadvisor.com/Profile/bcbdg1", "username": "bcbdg1", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/03/dc/10/b2/bcbdg1.jpg", "contribution_count": 11, "hometown": {"tripadvisor_entity_id": 154943, "location_name": "Vancouver", "location_name_detailed": "Vancouver, Canada"}, "is_verified": false}, "images": [], "created_at_date": "2013-05-04", "published_at_date": "2013-05-04"}, {"review_id": 159601901, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r159601901-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "A rare chance to visit one of Hinduism's most sacred sites", "text": "Pashupatinath is one of the oldest Hindu temples in Nepal, and its burning ghats are the main cremation site for Nepali Hindus.\nBeing allowed to see it is a huge privilege - Hindu temples are normally strict about not letting non-Hindus see their rites - so if you go please do so with respect & you'll learn a great deal about funeral practices in an otherwise fairly secretive religion\n", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2013-05-31"}, "reviewer": {"reviewer_id": "1FA6C1D3DB86680427EFF1CC606A065A", "name": "sewaterman", "profile_link": "https://www.tripadvisor.com/Profile/sewaterman", "username": "sewaterman", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-s/01/52/8c/91/sewaterman.jpg", "contribution_count": 398, "hometown": {"tripadvisor_entity_id": 154943, "location_name": "Vancouver", "location_name_detailed": "Vancouver, Canada"}, "is_verified": false}, "images": [], "created_at_date": "2013-05-04", "published_at_date": "2013-05-04"}, {"review_id": 159535127, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r159535127-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Religious time", "text": "The temple Pashupati Nath Temple is the biggest temple of Lord Shiva. This temple is a place where a person can go and spend few time chanting prayers and the foreigners may have a look at the priests praying in each and every corner of the temple in diffferent ways.\n", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2013-01-31"}, "reviewer": {"reviewer_id": "B9C5A6B3092C79EE138DFAEEE9C2289C", "name": "sumant_khetan", "profile_link": "https://www.tripadvisor.com/Profile/sumant_khetan", "username": "sumant_khetan", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/06/e7/6c/44/sumant-khetan.jpg", "contribution_count": 5, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2013-05-03", "published_at_date": "2013-05-03"}, {"review_id": 159134961, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r159134961-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "too expensive", "text": "1000 roupies, that is 10 euros and you can not get into the temple, which is reserved for hindus, the only thing interesting is the crematoria but still 1000 roupies this is a lot of money in Nepal", "review_tip": null, "rating": 1, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2013-04-30"}, "reviewer": {"reviewer_id": "C9BD895642637E419BC1FBC84D6FA867", "nam