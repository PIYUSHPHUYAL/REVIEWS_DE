sponse": null, "trip": {"trip_type": null, "stay_date": "2020-01-31"}, "reviewer": {"reviewer_id": "E31B117BD91F29A68C207AD5ACD854E0", "name": "Paul S", "profile_link": "https://www.tripadvisor.com/Profile/Paul17e", "username": "Paul17e", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e7/7b/default-avatar-2020-56.jpg", "contribution_count": 5, "hometown": {"tripadvisor_entity_id": 255068, "location_name": "Brisbane", "location_name_detailed": "Brisbane, Australia"}, "is_verified": false}, "images": [], "created_at_date": "2020-01-19", "published_at_date": "2020-01-19"}, {"review_id": 739628573, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r739628573-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Important religious site for Hindus", "text": "This temple was one of the four most important religious sites in Asia for the followers of Shiva, one of the main gods of Hinduism. A non Hindu person was not allowed to enter the temple.  It costs 1,000 rupee per person to enter the grounds surrounding the temple. Cows and monkeys roam the area.\nThe temple and crematorium were located on the banks of the Bagmati River.  Along the bank were concrete platforms where people were cremated and the ashes put in the river.  The general area was a mixture of emotions and activities with mourners, vendors selling marigolds and souvenirs, Sadhus people who practice extreme discipline, locals and tourists.\n", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2019-12-31"}, "reviewer": {"reviewer_id": "801F615A9CEF1FA146B96B90FBAF1426", "name": "minnesotans4", "profile_link": "https://www.tripadvisor.com/Profile/minnesotans4", "username": "minnesotans4", "avatar": null, "contribution_count": 3320, "hometown": {"tripadvisor_entity_id