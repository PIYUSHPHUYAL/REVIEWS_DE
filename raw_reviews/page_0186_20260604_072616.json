blished_at_date": "2012-10-13"}, {"review_id": 142680690, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r142680690-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Incredible, eye opening", "text": "For someone from the \"western\" world, this was an incredible place for us to visit, just to soak in the atmosphere and to watch the people and experience the cremations. Very educational and emotional and something you will never forget. Don't miss it.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2012-08-31"}, "reviewer": {"reviewer_id": "B4D4E32CA19EFAB4E321DCE4BFFDC234", "name": "default29012019", "profile_link": "https://www.tripadvisor.com/Profile/default29012019", "username": "default29012019", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/10/bd/d5/bb/salsajo.jpg", "contribution_count": 6849, "hometown": {"tripadvisor_entity_id": 154954, "location_name": "Winnipeg", "location_name_detailed": "Winnipeg, Canada"}, "is_verified": false}, "images": [], "created_at_date": "2012-10-12", "published_at_date": "2012-10-12"}, {"review_id": 142678109, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r142678109-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "The burning of budies is not a pleasent sight", "text": "The only reason people visit Psshupatinath is to see the cremation of dead Nepalese. We did not like it. The place is dirty. The smell is horrible. We will not return.", "review_tip": null, "rating": 1, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2012-10-31"}, "reviewer": {"reviewer_id": "AAEC8787CBDA8E9467D61749D4C6A31B", "name": "Alon", "profile_link": "https://www.tripadvisor.com/Profile/Alonh1000", "username": "Alonh1000", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/06/26/60/2a/alonh1000.jpg", "contribution_count": 713, "hometown": {"tripadvisor_entity_id": 2144099, "location_name": "Mazkeret Batya", "location_name_detailed": "Mazkeret Batya, Israel"}, "is_verified": false}, "images": [], "created_at_date": "2012-10-12", "published_at_date": "2012-10-12"}, {"review_id": 142654098, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r142654098-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "strong experience", "text": "Unless you want to be shocked, I would not advise to visit it. Public cremations, dirty river, smell of burned meat and a thick cloud of ashes in the air. It was quite a strong experience.", "review_tip": null, "rating": 1, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2012-02-29"}, "reviewer": {"reviewer_id": "62D42B5F4258370C79A8FFEA3C630935", "name": "Christina M", "profile_link": "https://www.tripadvisor.com/Profile/voyaguer_du_monde", "username": "voyaguer_du_monde", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-s/02/e6/1f/2e/voyaguer-du-monde.jpg", "contribution_count": 13, "hometown": {"tripadvisor_entity_id": 188644, "location_name": "Brussels", "location_name_detailed": "Brussels, Belgium"}, "is_verified": false}, "images": [], "created_at_date": "2012-10-12", "published_at_date": "2012-10-12"}, {"review_id": 142552428, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r142552428-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "An amazing look into the life and death of Hindus.", "text": "Pashupatinath was a solemn look into Hindus end of life practices are carried out.  The funeral pyres seem to be going around the clock, and the mourners endless.  A guide is crucial in my opinion as most guide books only point out the basics, but a good guide will answer many questions about the rituals you see happening on both sides of the river.\n\n*Note: There are plenty of tourist police that are very friendly, but are busting unlicensed guides.  I witnessed many groups losing their guides they paid as the tourism dept is trying to crack down on frauds.  Licensed guides go through rigorous studies to insure accurate information and good presentation is given to all tourists.  Make sure yours has a license.  I can recommend Kumar Dahal which I used for multiple days and was very helpful and informative. kumarngo@hotmail.com\n\nPashupatinath and Bodnath Stupa are close to the airport area, try to work that into your plans when you are nearby; either coming, going or taking an Everest flight.  I hired a car and driver through my guide, so I was able to hit these as soon as I landed and just left my luggage in the car.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2012-10-31"}, "reviewer": {"reviewer_id": "56D182C0AE948C23B0EB3559A758312E", "name": "Graybeard73", "profile_link": "https://www.tripadvisor.com/Profile/Graybeard73", "username": "Graybeard73", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-s/02/e0/5c/1d/graybeard73.jpg", "contribution_count": 154, "hometown": null, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-s/02/f5/b6/83/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-s/02/f5/b6/a8/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-s/02/f5/b6/cf/pashupatinath-temple.jpg"], "created_at_date": "2012-10-11", "published_at_date": "2012-10-11"}, {"review_id": 142528674, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r142528674-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "If you want to see a cremation of a human body", "text": "It is a very interesting site but only if you are able to handle strong smells(burnt human flesh). Not clean at all. You will find a good number of \"exciting saddhus\" to take a picture with. You can just see the \"ghats\" cremation sites from the other side of the river", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2012-10-31"}, "reviewer": {"reviewer_id": "A3C0661CFB3C79F643659AB27F7D50F1", "name": "carlos f", "profile_link": "https://www.tripadvisor.com/Profile/carlosf202", "username": "carlosf202", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/03/70/97/96/carlos-f.jpg", "contribution_count": 109, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2012-10-11", "published_at_date": "2012-10-10"}, {"review_id": 142404691, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r142404691-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Jyotirlinga in dire need of maintenance", "text": "Its one of the twelve jyotirlinga of Lord Shiva. But is in a very sad state. It needs repair and regular cleaning of the surroundings.The temple is open at 5 AM but closes in the afternoon and reopens at 5 PM. Only Hindus are allowed to enter. Inside a number of temples of other gods & goddesses are there. At the back is river baghmati and also the cremation ghat for Hindus. If you are religious then you will not mind the sorroundings and love the temple. ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 4, "language": 