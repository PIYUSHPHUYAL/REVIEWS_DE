p": {"trip_type": "family", "stay_date": "2012-08-31"}, "reviewer": {"reviewer_id": "D563443BE557C59A192B798CFF5733AE", "name": "Mallik S", "profile_link": "https://www.tripadvisor.com/Profile/MallikS_12", "username": "MallikS_12", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-s/02/d7/70/f5/mallik-s.jpg", "contribution_count": 5, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2012-09-08", "published_at_date": "2012-09-07"}, {"review_id": 139536242, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r139536242-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Eye opener.", "text": "This is the first I have seen a cremation which I witnessed right from the start. The tour guide told us that we are lucky, we get to see a cremation from the beginning! It is open and public, we sat across the river and could see the ceremony. We didn't go into the temple itself as it is only open to devotees, however we did get to take beautiful pictures from across the hill. Do visit this this temple and witness the cremation, it is eye opening to say the least.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2011-11-30"}, "reviewer": {"reviewer_id": "71252505BB76FAE22195BF70F1AA3523", "name": "ChyH", "profile_link": "https://www.tripadvisor.com/Profile/ChyH", "username": "ChyH", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-s/02/d3/c4/d4/chyh.jpg", "contribution_count": 58, "hometown": {"tripadvisor_entity_id": 298570, "location_name": "Kuala Lumpur", "location_name_detailed": "Kuala Lumpur, Malaysia"}, "is_verified": false}, "images": [], "created_at_date": "2012-09-06", "published_at_date": "2012-09-05"}, {"review_id": 139443974, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r139443974-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Cremations", "text": "I have read about public cremations and it was most interesting to see first hand how the cremation ceremonies were carried out.  It was raining the day I was there, which made it even more dismal. Just around the corner from the cremations was an \"old folks home\" somewhat dismal also, but interesting.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2012-05-31"}, "reviewer": {"reviewer_id": "538901C8F79860FDF8489D641372AA09", "name": "Dan W", "profile_link": "https://www.tripadvisor.com/Profile/489DanW", "username": "489DanW", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/03/94/17/b2/dan-w.jpg", "contribution_count": 7, "hometown": {"tripadvisor_entity_id": 33047, "location_name": "Santa Clarita", "location_name_detailed": "Santa Clarita, California"}, "is_verified": false}, "images": [], "created_at_date": "2012-09-05", "published_at_date": "2012-09-04"}, {"review_id": 138893688, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r138893688-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "the best in kathmandu", "text": "i am a devitee of lord siva and pasupatinath is an very holy shrine for me.i have visited it at least 20 times earlier. this time i went after 4 years.\n\nand what a transformation !! the periphery development is excellent.the gardens,approach and exit roads etc. are very good now.the river bank is also very beautiful now.the facilities have improved tremendously.\n\nand the lord himself is benevolent as usual.will definitely visit again.\n\nhearty thanks to the temple trust for all round improvements in this holiest of shrine.", "review_tip": null, "rating": 5, "sub