: [], "created_at_date": "2016-07-23", "published_at_date": "2016-07-23"}, {"review_id": 395874303, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r395874303-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "u can feel the power of god", "text": "superb world heritage site. u must go if u like indian culture and hindu religion. u can feel the power of god", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "business", "stay_date": "2016-07-31"}, "reviewer": {"reviewer_id": "D700D15BE676F87389A41D5B6B245C1F", "name": "Lalit_Kumar_Agrawal", "profile_link": "https://www.tripadvisor.com/Profile/Lalit_Agrawal", "username": "Lalit_Agrawal", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/29/e1/42/45/caption.jpg", "contribution_count": 70, "hometown": {"tripadvisor_entity_id": 424936, "location_name": "Biratnagar", "location_name_detailed": "Biratnagar, Nepal"}, "is_verified": false}, "images": [], "created_at_date": "2016-07-23", "published_at_date": "2016-07-23"}, {"review_id": 395854426, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r395854426-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Om namah Shiva.........", "text": "The view of the temple is breath taking, old grand covered in silver with a huge sacred Nandi idol facing the main shrine is heavenly. one forgets the existence of material world and realizes the true being. Darshan of Pashupatinathji takes one away to the world of spirituality. its a heavenly feeling being there", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "business", "stay_date": "2016-04-30"}, "reviewer": {"reviewer_id": "5A605DF0A2AF79C68C0E099403F7EAB1", "name": "Arijit2410", "profile_link": "https://www.tripadvisor.com/Profile/Arijit2410", "username": "Arijit2410", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/05/77/f2/4c/arijit2410.jpg", "contribution_count": 73, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2016-07-23", "published_at_date": "2016-07-23"}, {"review_id": 395806027, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r395806027-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "The divinity in Kathmandu", "text": "I had missed visiting the Pashupatinath during my first visit to Kathmandu.\n\nHence during my trip in May 2016, I had decided that I would not miss visiting one of the most holy temples for Hindus.\n\nThe temple, a UNESCO world heritage site, is very well maintained. Once you enter the temple, there are many shrines dedicated to lord Shiva, including the main temple, a site where there are supposed to be 555 Shiv Lingas (did not count, though seemed to be a fair number). After exiting the temple went to the shore of the Bagmati river right besides the temple where here are some smaller shrines. Also, one may see a number of cremations taking place at the site. \n\nOverall, the place just calms you down. A divine experience indeed.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2016-05-31"}, "reviewer": {"reviewer_id": "580F26C7AE7403F3D2519FEFE1F4F936", "name": "AbhijitRaja", "profile_link": "https://www.tripadvisor.com/Profile/AbhijitRaja", "username": "AbhijitRaja", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/20/b7/0b/abhijitraja.jpg", "contribution_count": 81, "hometown": {"tripadvisor_entity_id": 304554, "location_name": "Mumbai", "location_name_detailed": "Mumbai, India"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/25/11/58/row-of-shrines-bedies.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/25/11/e8/entrance-to-the-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/25/12/59/shiv-lingas.jpg"], "created_at_date": "2016-07-23", "published_at_date": "2016-07-23"}, {"review_id": 395781644, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r395781644-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Best of Hindusm", "text": "This is really good to know about hindusm.This is very ever to learn about Hindusm.Deffinaly like it.I will recommend you you.and don't miss this place to visit in Nepal ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2015-11-30"}, "reviewer": {"reviewer_id": "991BDB51F2FF617F2EDCD31C5EF8F43C", "name": "Ganesh A", "profile_link": "https://www.tripadvisor.com/Profile/90ganesha", "username": "90ganesha", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-f/01/2e/70/63/avatar041.jpg", "contribution_count": 15, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2016-07-23", "published_at_date": "2016-07-23"}, {"review_id": 395654283, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r395654283-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Large temple and compound", "text": "This temple was very busy when we visited and entry to some areas was restricted to those not of the Hindu faith. The cremations pyres were somber to observe and photos were frowned upon- naturally.  Very spiritual place", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2016-07-31"}, "reviewer": {"reviewer_id": "6F894180DDDC56D320113F70BF751197", "name": "Rhonda A", "profile_link": "https://www.tripadvisor.com/Profile/RhondaA60", "username": "RhondaA60", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/eb/6d/default-avatar-2020-19.jpg", "contribution_count": 374, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2016-07-22", "published_at_date": "2016-07-22"}, {"review_id": 395159382, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r395159382-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "must visit holy place!", "text": "felt the divine power , being inside the temple. it was our first time to visit pashupatinath, and the experience was overwhelming, I strongly believe one can't visit shiv, unless he calls, after my several visits to nepal, Shiv finally called me this july to visit HIM. the main shrine has four dwars and one must take darshan from all direction. the temple has many small shrines for ganpathy, hanuman and others. make sure you visit all of them. going around the 108 shivlingams are very special , so don't miss it.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2016-07-31"}, "reviewer": {"reviewer_id": "3D5448C405F4BF8B0847D20571E9992E", "name": "Sadhana K", "profile_link": "https://www.tripadvisor.com/Profile/PassionEye", "username": "PassionEye", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/12/af/91/avatar.jpg", "contribution_count": 27, "hometown": {"tripadvisor_entity_id": 294012, "location_name": "United Arab Emirates", "location_name_detailed": "United Arab Emirates"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/1a/d5/6b/sadhus-in-front-of-pashupatina.jpg"], "created_at_date": "2016-07-21", "published_at_date": "2016-07-21"}, {"review_id": 394938803, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r394938803-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Great Temple", "text": "We visited the temple early in the morning . In the Hindu practices before visiting Temples one should have a shower and if planned to offer puja then should fast untill the completion of Puja.. Before entering the temple complex there are shops on both sides of the road . Flowers and essential things for Puja are available there.We entered the complex bare footed keeping our shoes in a place . In addition to visitors there are hundreds of pigeons ,giant goats and lot of monkeys.As we walk past the exterior we saw shadus sitting outside.. Till the gate of main temple complex photography allowed after that not.. Lot of people  are  queued to have darshan and offer Puja.Beside main temple there are temples of small deities.People are offering oil lamps. In the East of the temple river Bagmati flows . From the temple plain itis 100 to 150 feet down. On the constant cremation fire is on..In the evening there are aratis onin the Temple and in te far bank of Bagmati . In the tranquil atmosphere music and religious dance is really wonderful and fills one`s heart.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2016-07-31"}, "reviewer": {"reviewer_id": "157F0DEC445C31C7130C5C270CC4855A", "name": "Tapanmc", "profile_link": "https://www.tripadvisor.com/Profile/Tapanmc", "username": "Tapanmc", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/27/ab/3c/be/tapanmc.jpg", "contribution_count": 654, "hometown": {"tripadvisor_entity_id": 293936, "location_name": "Dhaka City", "location_name_detailed": "Dhaka City, Bangladesh"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/18/31/e0/sadhus.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/18/31/fe/out-side-of-main-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/18/32/93/temple-complex.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/18/33/01/infront-of-main-complex.jpg"], "created_at_date": "2016-07-21", "published_at_date": "2016-07-20"}, {"review_id": 394749225, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r394749225-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "well maintained and divine place", "text": "certainly a well maintained temple. fully neat and clean. this place gives huge peace of mind and its very divine. wow the pigeons near temple are almost one of the attraction where one can feed  pigeons with thier food which can be purchased from stores outside temple.\nif you wish to attend pooja aari kindly make sure this is performed only in the evening by 7 pm sharp.\nphotography not allowed inside the temple but you can carry your mobile phones inside.\noverall very well maintained temple and no cheating or frauds by any people. a safe place to visit.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2016-07-31"}, "reviewer": {"reviewer_id": "99A12F05CEC7E84054A7A9755FFD7889", "name": "concepts", "profile_link": "https://www.tripadvisor.com/Profile/concepts", "username": "concepts", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/df/2b/default-avatar-2020-39.jpg", "contribution_count": 84, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2016-07-20", "published_at_date": "2016-07-20"}, {"review_id": 394703529, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r394703529-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Totally great", "text": "In the temple, you can know how Nepali see death. Its impressive. If i have to choose only one sightseeing point in Kathmandu, this is the one", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2016-07-31"}, "reviewer": {"reviewer_id": "7A7C26875919F1E7567DDC9AAD1E2282", "name": "tochingyuet", "profile_link": "https://www.tripadvisor.com/Profile/tochingyuet", "username": "tochingyuet", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/eb/e3/default-avatar-2020-59.jpg", "contribution_count": 2, "hometown": {"tripadvisor_entity_id": 294217, "location_name": "Hong Kong", "location_name_detailed": "Hong Kong, China"}, "is_verified": false}, "images": [], "created_at_date": "2016-07-20", "published_at_date": "2016-07-20"}, {"review_id": 394539749, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r394539749-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "only hindus are allowed not other", "text": "since non hindus are not allowed its worth not to visit the place yet if you are interested in seeing cremation you may go there ", "review_tip": null, "rating": 2, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": null, "stay_date": "2015-11-30"}, "reviewer": {"reviewer_id": "CE5E39845F1D43F046C05BD689A87D53", "name": "Times N", "profile_link": "https://www.tripadvisor.com/Profile/214devd", "username": "214devd", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/de/e7/default-avatar-2020-37.jpg", "contribution_count": 2, "hometown": {"tripadvisor_entity_id": 293890, "location_name": "Kathmandu", "location_name_detailed": "Kathmandu, Nepal"}, "is_verified": false}, "images": [], "created_at_date": "2016-07-20", "published_at_date": "2016-07-19"}, {"review_id": 394529545, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r394529545-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "temple in nepal", "text": "me and my wife visit in kathmanu pashupati temple which is old n power of god shiva .fastival of mahashivaratri many people come here n pray of god to clebret.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2016-07-31"}, "reviewer": {"reviewer_id": "AAB4F4F58DBBB165D8FDD6066A1ABB9B", "name": "thomajil", "profile_link": "https://www.tripadvisor.com/Profile/thomajil", "username": "thomajil", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e9/ef/default-avatar-2020-66.jpg", "contribution_count": 1, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2016-07-20", "published_at_date": "2016-07-19"}, {"review_id": 394469884, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r394469884-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Interesting place to visit", "text": "If you are in Kathmandu this is a place you should see.  It is helpful to have a \"guide\" which is easier to find than to get rid of if you don't want, and you should negotiate their expectations beforehand.  There are place non Hindus cannot access here but there is plenty more to see.  Again it would be hard without a guide to know exactly what you are seeing here.  Overall I found this a worthwhile use of 2-3 hours.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": null, "stay_date": "2016-07-31"}, "reviewer": {"reviewer_id": "092AD2A3557FE486AC13E52B1CB012ED", "name": "BrandonNCo", "profile_link": "https://www.tripadvisor.com/Profile/BrandonNCo", "username": "BrandonNCo", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-s/02/d9/e8/da/brandonnco.jpg", "contribution_count": 257, "hometown": {"tripadvisor_entity_id": 33388, "location_name": "Denver", "location_name_detailed": "Denver, Colorado"}, "is_verified": false}, "images": [], "created_at_date": "2016-07-19", "published_at_date": "2016-07-19"}, {"review_id": 394310488, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r394310488-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "The best place in Kathmandu", "text": "Real place for visit.... holy place.... lovely place.... great place.... people come to know what is life after being this place because after death Hindu people do last process right here only. Lively getting chance to see after death processing.\n\nVery great holy place....\n\nThe monkey adventure make you feel different....", "review_tip": null, "rating": 5, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2016-07-31"}, "reviewer": {"reviewer_id": "204BF9010E63EA8DF43C8899633959D3", "name": "Rajesh P", "profile_link": "https://www.tripadvisor.com/Profile/405rajeshp", "username": "405rajeshp", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1b/73/27/26/405rajeshp.jpg", "contribution_count": 23, "hometown": {"tripadvisor_entity_id": 293890, "location_name": "Kathmandu", "location_name_detailed": "Kathmandu, Nepal"}, "is_verified": false}, "images": [], "created_at_date": "2016-07-19", "published_at_date": "2016-07-19"}, {"review_id": 393555182, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r393555182-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Poor value", "text": "Did not find this to be a sight worth visiting based on the high price of admission, restrictions on where you could go and general lack of information.  Understanding this is an actual working temple complex and people are here to worship, I didn't expect there to be tourist placards, but maybe just general information near structures that everyone could benefit from.  Like other places in Kathmandu, they have likely raised the price post-earthquake to help fund recovery.  I am happy to pay the extra fee, but here despite high admission, the water is full of trash and there is garbage.  I left a bit disappointed.", "review_tip": null, "rating": 3, "subratings": [], "like_count": 2, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2016-05-31"}, "reviewer": {"reviewer_id": "5C38075AD6D89256F203F7EA1C03AA1B", "name": "Talia R", "profile_link": "https://www.tripadvisor.com/Profile/203taliar", "username": "203taliar", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e8/5b/default-avatar-2020-61.jpg", "contribution_count": 178, "hometown": {"tripadvisor_entity_id": 60763, "location_name": "New York City", "location_name_detailed": "New York City, New York"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/0d/9c/b1/gathering.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/0d/9c/cc/monkey-friend.jpg"], "created_at_date": "2016-07-17", "published_at_date": "2016-07-17"}, {"review_id": 393122783, "review_link": "https://www.tripadvisor.com