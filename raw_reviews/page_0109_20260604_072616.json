ted_at_date": "2016-07-11", "published_at_date": "2016-07-11"}, {"review_id": 391247488, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r391247488-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "A tample to visit", "text": "Went there twice, \none it happened with Lord Shiva Birthday... it was really remarkable visit and if you can get ur visit in this period it would be much nicer and busier than normal days. \n", "review_tip": null, "rating": 4, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": null, "stay_date": "2015-09-30"}, "reviewer": {"reviewer_id": "22D4BA38B56ABB057C90E13839ED6A46", "name": "AmrBabili", "profile_link": "https://www.tripadvisor.com/Profile/AmrBabili", "username": "AmrBabili", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e7/99/default-avatar-2020-57.jpg", "contribution_count": 15, "hometown": {"tripadvisor_entity_id": 295424, "location_name": "Dubai", "location_name_detailed": "Dubai, United Arab Emirates"}, "is_verified": false}, "images": [], "created_at_date": "2016-07-11", "published_at_date": "2016-07-11"}, {"review_id": 390401445, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r390401445-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "A very interesting place", "text": "Well worth a visit. This is an important Hindu shrine although non Hindus cannot go into the main area. Much to see. The crematoria are part of the same complex. ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": null, "stay_date": "2016-07-31"}, "reviewer": {"reviewer_id": "5B239BDBEEBFC52E58EFAF5C6E4FAEDE", "name": "WilsonEwelme", "profile_link": "https://www.tripadvisor.com/Profile/WilsonEwelme", "username": "WilsonEwelme", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/05/9c/12/d2/wilsonewelme.jpg", "contribution_count": 242, "hometown": {"tripadvisor_entity_id": 1486946, "location_name": "Benson", "location_name_detailed": "Benson, United Kingdom"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0b/e4/d1/4a/photo0jpg.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0b/e4/d1/4b/photo1jpg.jpg"], "created_at_date": "2016-07-08", "published_at_date": "2016-07-08"}, {"review_id": 390356990, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r390356990-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Divine enlightenment ", "text": "For Hindu's this ancient temple offers a site where the can worship lord Shiva. This site has immense religious and spiritual value for Hindu's.  \n\nThree holy sites are based in India naming Amaranath, Kedarnath and Badrinath and the fourth is Pashupatinath based in NEPAL. \n\nLot of improvements have been done and it s better organized now in comparison to what it was 8 or 10 years ago. \n", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2016-07-31"}, "reviewer": {"reviewer_id": "8BD64461750E41223D6FB7BF9571DA2C", "name": "Dannysharma", "profile_link": "https://www.tripadvisor.com/Profile/Dannysharma", "username": "Dannysharma", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/80/a3/a0/dannysharma.jpg", "contribution_count": 55, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2016-07-08", "published_at_date": "2016-07-08"}, {"review_id": 390262798, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r390262798-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "A Jyotirlinga", "text": "Pashupatinath is one of the Jyotirlingas. I went there and worshipped Lord Shiva. The main temple has 4 gates. Its very easy to have darshana of Lord Shiva.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2016-07-31"}, "reviewer": {"reviewer_id": "D9BB731F0AAB2F84CD62217598466CE8", "name": "ASEEM MEHROTRA", "profile_link": "https://www.tripadvisor.com/Profile/aseemm1984", "username": "aseemm1984", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/de/e7/default-avatar-2020-37.jpg", "contribution_count": 267, "hometown": {"tripadvisor_entity_id": 186534, "location_name": "Glasgow", "location_name_detailed": "Glasgow, United Kingdom"}, "is_verified": false}, "images": [], "created_at_date": "2016-07-08", "published_at_date": "2016-07-07"}, {"review_id": 390144425, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r390144425-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "many tourists", "text": "many tourists but then again i am one of them. For those interested in temples it is a must. and the monkeys running around are funny but take care, they can be very agressive.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2016-07-31"}, "reviewer": {"reviewer_id": "3EAC616B9E9A689C2D84A511EC3DCB41", "name": "frans1954", "profile_link": "https://www.tripadvisor.com/Profile/frans1954", "username": "frans1954", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/ef/32/default-avatar-2020-12.jpg", "contribution_count": 93, "hometown": {"tripadvisor_entity_id": 188576, "location_name": "Roermond", "location_name_detailed": "Roermond, The Netherlands"}, "is_verified": false}, "images": [], "created_at_date": "2016-07-07", "published_at_date": "2016-07-07"}, {"review_id": 390098920, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r390098920-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Pashupatinath Temple", "text": "The sacro sanctum, or the main idol is a stone Mukhalinga with a silver yoni base bound with silver serpent .The lingam is one metre high and has faces in four directions .These faces represents various ascepts of Shiva; Sadyojata (also known as Barun), Vamdeva (also known as Ardha nareshwor), Tatpurusha, Aghor & Ishana (imaginative).Facing West, North, East, South and Zenith respectively representing five primary elements namely earth, water, air, light and ether.[10] Each face has tiny protruding hands holding rudraksha mala on right hand and a kamandalu on the other.Unlike other shiva lingams in India and Nepal this pashupati shiva lingam is always Dressed in its golden vastra except during abhishakam, so pouring milk and ganga jal is only possible during abhishakam through the main priests", "review_tip": null, "rating": 5, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2016-06-30"}, "reviewer": {"reviewer_id": "7877D1BF9ECEA3DCC3B8FFC4034C2C85", "name": "Neetha R", "profile_link": "https://www.tripadvisor.com/Profile/305neethar", "username": "305neethar", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0b/ca/ab/0d/neetha-r.jpg", "contribution_count": 14, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2016-07-07", "published_at_date": "2016-07-07"}, {"review_id": 389419249, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r389419249-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Don't Miss this Temple ", "text": "I almost didn't go this temple, but am very glad I did! The temple is very interesting and you see and last so much about the Hindu religion.  The area itself is beautiful and open the curious. \n\nAs with just about everyplace in Kathmandu you will pick up a \"shadow\"  or guide if you don't have one.  A firm no thanks usually gets rid of them but some are persistent. ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2016-07-31"}, "reviewer": {"reviewer_id": "6214B7FA70D0ACA44653B84248220272", "name": "Stiv_Wa", "profile_link": "https://www.tripadvisor.com/Profile/Stiv_Wa", "username": "Stiv_Wa", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/f1/42/default-avatar-2020-20.jpg", "contribution_count": 269, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2016-07-05", "published_at_date": "2016-07-05"}, {"review_id": 389299213, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r389299213-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Lord of the lords....Mahadev", "text": "Once again... i am short of words to describe the feeling that i was so much overwhelmed with. Life is short and one must come here to enhance it. Our breath become lost here....and we both couldnt relate with each other.......that was the devine phenomenon we experienced. So much connected to lord....so much of his glory is defined here....so much of love...so much of truth of life from beginning to end is experienced in our few hours of visit here. The purity...the love...the grace of the almighty mahadev..... all felt and just felt. Lost in transaltion i am...and we bith were there. Once in a lifetime event.....which we want to experience every other time.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2016-07-31"}, "reviewer": {"reviewer_id": "5109C195ED414D46862C71BC0FEBA26D", "name": "Ashish Raj M", "profile_link": "https://www.tripadvisor.com/Profile/ashishrajm", "username": "ashishrajm", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0e/79/55/f3/ashish-raj-m.jpg", "contribution_count": 28, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2016-07-05", "published_at_date": "2016-07-05"}, {"review_id": 389254882, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r389254882-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "A must visit for all Hindus", "text": "The religious significance of the site is well known to all hindus. Can get very busy, the area isn't as clean as it could or should be. Some of the people charged with crowd control can be a little bit over enthusiastic (shall we say) and that can take away from the peaceful nature of the site", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": null, "stay_date": "2016-07-31"}, "reviewer": {"reviewer_id": "82F1F0847D8BC46F32226FBCDFF55A23", "name": "Sanjnnim", "profile_link": "https://www.tripadvisor.com/Profile/Sanjnnim", "username": "Sanjnnim", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/f2/7a/default-avatar-2020-25.jpg", "contribution_count": 132, "hometown": {"tripadvisor_entity_id": 186334, "location_name": "Leicester", "location_name_detailed": "Leicester, United Kingdom"}, "is_verified": false}, "images": [], "created_at_date": "2016-07-05", "published_a