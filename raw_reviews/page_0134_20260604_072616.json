wUserReviews-g293890-d310712-r266760171-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Life time experience to be able to watch cremation by the Bagmati River", "text": "A holy sacred place for the Hindus. Could not enter the temple proper because I am not a Hindu. The whole area is vast. Spent some time by the Bagmati river to watch cremation. Many Lingam statures.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2014-10-31"}, "reviewer": {"reviewer_id": "A2A1362EBB23788D5862438AE2BBA1B3", "name": "Tony Y", "profile_link": "https://www.tripadvisor.com/Profile/koksengy", "username": "koksengy", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/06/e2/b8/kok-seng-y.jpg", "contribution_count": 900, "hometown": {"tripadvisor_entity_id": 298303, "location_name": "George Town", "location_name_detailed": "George Town, Malaysia"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/ba/9c/34/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/ba/9c/35/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/ba/9c/36/pashupatinath-temple.jpg"], "created_at_date": "2015-04-20", "published_at_date": "2015-04-20"}, {"review_id": 266362215, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r266362215-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Only if you want to see Hindu cremation ceremonies would I recommend.", "text": "   This was interesting but had I known that primarily the highlight would be witnessing Hindu cremation along the river, I would have passed.  For me, this was somewhat of an intrusion as foreigners and visitors watched these families say goodbye. It was sad to see and hear the mourning.  I was as guilty as everyone else as I watched but in hindsight I wish I wouldn't have visited this site.", "review_tip": null, "rating": 3, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": null, "stay_date": null}, "reviewer": {"reviewer_id": "549358D10A0172BAF837E1B479691091", "name": "Bill B", "profile_link": "https://www.tripadvisor.com/Profile/BillB777_12", "username": "BillB777_12", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/70/a3/07/bill-b.jpg", "contribution_count": 150, "hometown": {"tripadvisor_entity_id": 45963, "location_name": "Las Vegas", "location_name_detailed": "Las Vegas, Nevada"}, "is_verified": false}, "images": [], "created_at_date": "2015-04-18", "published_at_date": "2015-04-17"}, {"review_id": 266340791, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r266340791-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Holy temple", "text": "A Hindu cremation ground and where the living Hindus goes to have bath in Baghmati river\nTo free themselves from the cycle of rebirth. No leather bags or jackets are allowed in main temple complex. Personally I had a mix feeling to have witness cremation for the first time. It made me to review my own past and present life.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2015-04-30"}, "reviewer": {"reviewer_id": "5FCD7CFFDC1E5438C28CB5A3284838A8", "name": "Sarathy_03", "profile_link": "https://www.tripadvisor.com/Profile/Sarathy_03", "username": "Sarathy_03", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/b9/91/b7/sarathy-03.jpg", "contribution_count": 85, "hometown": {"tripadvisor_entity_id": 635527, "location_name": "Batu Ferringhi", "location_name_detailed": "Batu Ferringhi, Malaysia"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/b7/55/7c/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/b7/55/7d/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/b7/55/7e/pashupatinath-temple.jpg"], "created_at_date": "2015-04-17", "published_at_date": "2015-04-17"}, {"review_id": 266098790, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r266098790-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Temple of Lord Shiva", "text": "Its considered one of the most sacred temple in Nepal, its a very old and sacred temple.\nIt is a Chaturmukhi (four faced) on a Lingam opening out to four gates, the ancient carving and the stone art is simply superb. It is heavily crowded as it attracts a lot of tourists due to its values.\nThe not so good part was the monkey's which was scary and was all over the place, and would scare people trying to snatch the Prasad from them.\nOverall a very nice and serene place, good for photography as well and a must visit in Nepal.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 3, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2015-04-30"}, "reviewer": {"reviewer_id": "A723541053C08EB56AD945F966CBE77D", "name": "painulyhimanshu", "profile_link": "https://www.tripadvisor.com/Profile/painulyhimanshu", "username": "painulyhimanshu", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/15/93/27/ca/painulyhimanshu.jpg", "contribution_count": 320, "hometown": {"tripadvisor_entity_id": 304551, "location_name": "New Delhi", "location_name_detailed": "New Delhi, India"}, "is_verified": false}, "images": [], "created_at_date": "2015-04-16", "published_at_date": "2015-04-16"}, {"review_id": 266018759, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r266018759-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Real Hindu temple", "text": "You can see the crematorium of a lot of the hindus, very shocking but you can see an important part of their culture.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2015-03-31"}, "reviewer": {"reviewer_id": "AB4AC20772911FC1E7B7570F72D30325", "name": "Javier P", "profile_link": "https://www.tripadvisor.com/Profile/javierp645", "username": "javierp645", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e7/7b/default-avatar-2020-56.jpg", "contribution_count": 66, "hometown": {"tripadvisor_entity_id": 187514, "location_name": "Madrid", "location_name_detailed": "Madrid, Spain"}, "is_verified": false}, "images": [], "created_at_date": "2015-04-16", "published_at_date": "2015-04-16"}, {"review_id": 265787498, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r265787498-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Eye-opening", "text": "A very interesting experience. Try and hire a guide to learn about the customs and traditions. It was hard to believe that you could witness cremations at such a close distance.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2014-05-31"}, "reviewer": {"reviewer_id": "00FC60181B65D25960DF259999EE0B9B", "name": "Avril C", "profile_link": "https://www.tripadvisor.com/Profile/avalookoverhere", "username": "avalookoverhere", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/08/93/82/ee/avril-c.jpg", "contribution_count": 337, "hometown": {"tripadvisor_entity_id": 294217, "location_name": "Hong Kong", "location_name_detailed": "Hong Kong, China"}, "is_verified": false}, "images": [], "created_at_date": "2015-04-15", "published_at_date": "2015-04-14"}, {"review_id": 265773438, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r265773438-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Pilgrim Hub", "text": "This is one of the most important and sacred place of hindu religion. Its a temple of god Shiva. There are many temples in fact. The ancient architecture and stone art are clearly visible all across the temple. It is surrounded by a forest as well as a river which gives you a unique feeling of natural peace. A nice place to explore some hindu culture and history. \nNon-hindu followers are not allowed to go inside main temple building.", "review_tip": null, "rating": 3, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2015-04-30"}, "reviewer": {"reviewer_id": "406C04182A40726A796829A4ACF9EA81", "name": "Santosh G", "profile_link": "https://www.tripadvisor.com/Profile/484santoshg", "username": "484santoshg", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/81/9a/67/mesantosh99.jpg", "contribution_count": 98, "hometown": {"tripadvisor_entity_id": 293890, "location_name": "Kathmandu", "location_name_detailed": "Kathmandu, Nepal"}, "is_verified": false}, "images": [], "created_at_date": "2015-04-15", "published_at_date": "2015-04-14"}, {"review_id": 265770891, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r265770891-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "a good place to experience Hindu culture", "text": "not only the place, architecture and religion, but also the funeral would tell the beliefs of Hindu! ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2015-04-30"}, "reviewer": {"reviewer_id": "F3309CE2927170CD55EFF6A13660ABCB", "name": "kaichan777", "profile_link": "https://www.tripadvisor.com/Profile/kaichan777", "username": "kaichan777", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/09/86/c7/7e/kaichan777.jpg", "contribution_count": 5, "hometown": {"tripadvisor_entity_id": 294217, "location_name": "Hong Kong", "location_name_detailed": "Hong Kong, China"}, "is_verified": false}, "images": [], "created_at_date": "2015-04-14", "published_at_date": "2015-04-14"}, {"review_id": 265552419, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r265552419-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "If you go nowhere else go here", "text": "What an amazing place.  If you go here ask for a guide to take you around and tell you about the history of all that is going on.  The history behind the cremation ceremony is what is so fascinating.  Finding out the differences behind the HIndu and the Buddhist traditions are very interesting.  Then to have the fertility temple explained, the holy men traditions, and the temple itself.  Then to visit where they elderly are held and cared for is also very interesting. So much to see here.  Plan for at least 2 hours if not 3.  Without a guide you may not stay as long but the activities going on around you won't mean as much either because you won't understand the significance of what they are doing.  ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2015-03-31"}, "reviewer": {"reviewer_id": "3985910075A3F62789C41EBA79E360BE", "name": "Tina W", "profile_link": "https://www.tripadvisor.com/Profile/174tinaw", "username": "174tinaw", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/f4/5d/default-avatar-2020-32.jpg", "contribution_count": 12, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2015-04-13", "published_at_date": "2015-04-13"}, {"review_id": 265488883, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r265488883-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Sacred temple - very earthy and raw - a working olds of pilgrimage", "text": "This UNESCO listed world heritage site is a sacred place for Hindus and while non-Hindus can't enter the actual temple, we are permitted through the precinct and are allowed to visit some beautiful places - great for photography and people watching. However, many Hindus choose to be cremated on the ghats beside the river as it is considered sacred. You will see up to a dozen cremations daily - frequently with clear views across the river to the Pyrex. Show some respect for the families - it is a very emotional time for them. also, if you are squeamish, steer clear - you will see corpses and you will often see limbs sticking out of the flames. Also, that smell of barbequeued pork isn't what it seems... Those with a weak stomach should stay upwind", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2015-04-30"}, "reviewer": {"reviewer_id": "4A254106DD15EFD2CCA799540E7CC882", "name": "Neil R", "profile_link": "https://www.tripadvisor.com/Profile/NeilR838", "username": "NeilR838", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/f4/d0/default-avatar-2020-33.jpg", "contribution_count": 697, "hometown