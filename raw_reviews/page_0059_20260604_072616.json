ontribution_count": 157, "hometown": {"tripadvisor_entity_id": 4444106, "location_name": "Hoshangabad", "location_name_detailed": "Hoshangabad, India"}, "is_verified": false}, "images": [], "created_at_date": "2018-02-16", "published_at_date": "2018-02-17"}, {"review_id": 560824970, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r560824970-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Holy and Historical ", "text": "Centuries old temple, beliefs are there to claim the existence of a temple at the place from the third century BCE. It survived the earthquake of 2015 without any damage. The entry is exclusive to Hindus. Though others can visit the area.the temple is at the bank of river Bagmati. There is one main temple surrounded by many other small temples. This is a temple of lord Shiva. Check the local newspaper to find out the timings when all the four doors are open. There is arrangement for special pujas also on chargeable basis. We find monkeys all around the temple area so we must keep the Prasad hidden. Mobiles are not allowed to use within the main premise. We can't take pictures also inside the temple. ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2018-02-28"}, "reviewer": {"reviewer_id": "876178B23D25D11C22BC59002928DAF1", "name": "Alok Mishra", "profile_link": "https://www.tripadvisor.com/Profile/aloknbsm", "username": "aloknbsm", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0d/70/ba/f3/aloknbsm.jpg", "contribution_count": 1202, "hometown": {"tripadvisor_entity_id": 293890, "location_name": "Kathmandu", "location_name_detailed": "Kathmandu, Nepal"}, "is_verified": false}, "images": [], "created_at_date": "2018-02-16", "published_at_date": "2018-02-17"}, {"review_id": 559604889, "review_link": "http