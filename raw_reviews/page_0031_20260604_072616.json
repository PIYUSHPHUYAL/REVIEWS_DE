{"scraped_at": "2026-06-04T07:26:16.694941+00:00", "run_id": "20260604_072616", "page": 31, "api_response": {"count": 3946, "per_page": 20, "current_page": 31, "total_pages": 198, "next": "https://tripadvisor-scraper-api.omkar.cloud/reviews?query=https%3A%2F%2Fwww.tripadvisor.com%2FAttraction_Review-g293890-d310712-Reviews-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html&page=32&sort_by=most_recent&locale=en-US", "previous": "https://tripadvisor-scraper-api.omkar.cloud/reviews?query=https%3A%2F%2Fwww.tripadvisor.com%2FAttraction_Review-g293890-d310712-Reviews-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html&page=30&sort_by=most_recent&locale=en-US", "results": [{"review_id": 651571498, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r651571498-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "One of the most unforgettable experiences of our lives", "text": "This World Heritage Site on the banks of the Bagmati River is one of the most sacred Hindu shrines in the world.  Devotees meditate and pray on the steps, and many families are there to cremate loved ones on pyres along the river.  The individual pyres are decorated with ropes of crysanthenums, piled with tiers of wood, and surrounded by mourners.  We were stunned at first when the pyre was set alight, but we're very humbled to witness this ancient honorific rite.  Nameste.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2018-12-31"}, "reviewer": {"reviewer_id": "782EA169B2A19017E1118F351DA74316", "name": "Kathy V", "profile_link": "https://www.tripadvisor.com/Profile/448kathyv", "username": "448kathyv", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/08/5d/d0/ef/kathy-v.jpg", "contribution_count": 204,