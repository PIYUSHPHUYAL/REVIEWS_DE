-03-08"}, {"review_id": 657028846, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r657028846-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Peace, Beauty, Culture, and Spirituality", "text": "This is one of the holiest places for Hindus and is spiritually and culturally rich. The earthquake damage is being repaired slowly. I love the peaceful atmosphere.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2019-03-31"}, "reviewer": {"reviewer_id": "7E2F9155BD0449F88603257061F6712A", "name": "MARKOLA111", "profile_link": "https://www.tripadvisor.com/Profile/MARKOLA111", "username": "MARKOLA111", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e2/e6/default-avatar-2020-45.jpg", "contribution_count": 76, "hometown": {"tripadvisor_entity_id": 60878, "location_name": "Seattle", "location_name_detailed": "Seattle, Washington"}, "is_verified": false}, "images": [], "created_at_date": "2019-03-07", "published_at_date": "2019-03-07"}, {"review_id": 656959730, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r656959730-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Pashupatinath", "text": "Humbling and sombre place, it can get really overwhelming with the sights and sounds but it is an experience that will make you think about life and how we are not so different after all, wherever we come from. Did not take any photographs as we felt it was disrespectful, the picture is forever imprinted in our minds.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2019-03-31"}, "reviewer": {"reviewer_id": "97AFB80362205BEA411B913A5198CF56", "name": "lksg", "profile_link": "https://www.tripadvisor.com/Profile/LKTaySG", "username": "LKTaySG", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/2b/e8/54/41/lktaysg.jpg", "contribution_count": 155, "hometown": {"tripadvisor_entity_id": 298570, "location_name": "Kuala Lumpur", "location_name_detailed": "Kuala Lumpur, Malaysia"}, "is_verified": false}, "images": [], "created_at_date": "2019-03-07", "published_at_date": "2019-03-07"}, {"review_id": 656815854, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r656815854-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Pashupati Temple", "text": "Pashupati nath Temple is an UNESCO World Heritage site in Nepal. A lot of construction is being carried out around the temple area for the tourists. Sasuki car taxis are very popular in Nepal being imported from India. It has a small market to buy souvenirs.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2019-02-28"}, "reviewer": {"reviewer_id": "D6BA1A9A77311FF8EBB65B3B0142BBED", "name": "Bhavya", "profile_link": "https://www.tripadvisor.com/Profile/BhavyaMadan", "username": "BhavyaMadan", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/15/9c/df/b7/fearless33580067693.jpg", "contribution_count": 14, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2019-03-06", "published_at_date": "2019-03-06"}, {"review_id": 656813559, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r656813559-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Pasupati Nath Ji", "text": "A must visit for all Hindus all over the world. Non Hindus are not allowed. However, replica Pashupati Nath temple are also in India for those who are unable to visit Nepal due to age and cost. ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 2, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2019-02-28"}, "reviewer": {"reviewer_id": "D6BA1A9A77311FF8EBB65B3B0142BBED", "name": "Bhavya", "profile_link": "https://www.tripadvisor.com/Profile/BhavyaMadan", "username": "BhavyaMadan", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/15/9c/df/b7/fearless33580067693.jpg", "contribution_count": 14, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2019-03-06", "published_at_date": "2019-03-06"}, {"review_id": 656670581, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r656670581-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Great temples.", "text": "It was great experuence vising pashupati nath, biggest Hindu Temple, sits on the bank of river.There are number if shrines around temple where devotees offer worshiping. It seems the temples architechrual form was unique and started early medival time. \n\nYou will get pashupati by a taxi from Thamel which you exoect 400ruoiys", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2018-11-30"}, "reviewer": {"reviewer_id": "5495EAB556B687034CD4581752DB1F01", "name": "Shiam", "profile_link": "https://www.tripadvisor.com/Profile/Shiam9012", "username": "Shiam9012", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e2/11/default-avatar-2020-41.jpg", "contribution_count": 1, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2019-03-06", "published_at_date": "2019-03-06"}, {"review_id": 656521346, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r656521346-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "A spiritual and cultural oasis in Kathmandu", "text": "I love coming to Pashupatinath. As a foreigner, I am not allowed in the temple, but strolling the grounds and taking in the spiritual atmosphere is always very refreshing and enlivening. ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "business", "stay_date": "2019-03-31"}, "reviewer": {"reviewer_id": "7E2F9155BD0449F88603257061F6712A", "name": "MARKOLA111", "profile_link": "https://www.tripadvisor.com/Profile/MARKOLA111", "username": "MARKOLA111", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e2/e6/default-avatar-2020-45.jpg", "contribution_count": 76, "hometown": {"tripadvisor_entity_id": 60878, "location_name": "Seattle", "location_name_detailed": "Seattle, Washington"}, "is_verified": false}, "images": [], "created_at_date": "2019-03-05", "published_at_date": "2019-03-05"}, {"review_id": 656371506, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r656371506-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Captivating !", "text": "A visit there will remind you of a forgotten reality : death ! The cremation of these bodies and the ashes bluntly swept in the flowing canal remind you of what this life if worth !", "review_tip": null, "rating": 4, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2019-02-28"}, "reviewer": {"reviewer_id": "87C49CE75BDC1C6FA876D4D133CC66A8", "name": "LoneRunner Vagabond", "profile_link": "https://www.tripadvisor.com/Profile/WorldRunnerVagabond", "username": "WorldRunnerVagabond", "avatar": "https:/