namic-media-cdn.tripadvisor.com/media/photo-o/16/e0/f9/87/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/16/e0/f9/8d/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/16/e0/f9/91/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/16/e0/f9/9b/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/16/e0/f9/9f/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/16/e0/f9/a1/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/16/e0/f9/a2/pashupatinath-temple.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/16/e0/f9/a3/pashupatinath-temple.jpg"], "created_at_date": "2019-03-20", "published_at_date": "2019-03-20"}, {"review_id": 658948316, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r658948316-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Solemn Witness ", "text": "At first it seems intrusive, but it is a great way to get some insight into the Hindu cremation ritual. Watching is very personal and may be uncomfortable for some, but it is enlightening. The temple is off-limits to non-Hindus, so you will have to be satisfied with a walk around the grounds.  The Sadhus that hang around posing for pictures for cash are intriguing. ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2019-03-31"}, "reviewer": {"reviewer_id": "DD51E25FCC2C30461E82A5DE8C06FFF9", "name": "DL2Some", "profile_link": "https://www.tripadvisor.com/Profile/DL2Some", "username": "DL2Some", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-s/02/f3/8c/6f/gpotvin.jpg", "contribution_count": 915, "hometown": {"tripadvisor_entity_id": 43010, "location_name": "Detroit Lakes", "location_name_detailed": "Detroit Lakes, Minnesota"}, "is_verified": false}, "images": [], "created_at_date": "2019-03-17", "published_at_date": "2019-03-17"}, {"review_id": 658341843, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r658341843-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Morbid ", "text": "Was 10 bucks to visit for foreigners and was quite a morbid place. You basically stand on a bridge and u can see bodies burning on both sides of the river for different status classes and family members crying. They have bodies burning 24/7. Probably wouldn’t have gone again if I was to do it all over again. Mostly locals when I was there and mostly i guess was to observe the funeral process. Pretty sad place.", "review_tip": null, "rating": 2, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2019-03-31"}, "reviewer": {"reviewer_id": "16A699558226631301DE8A2943C5B2E0", "name": "terenceleezy", "profile_link": "https://www.tripadvisor.com/Profile/terenceleezy", "username": "terenceleezy", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/16/67/b4/9c/terence-l.jpg", "contribution_count": 25, "hometown": {"tripadvisor_entity_id": 52024, "location_name": "Portland", "location_name_detailed": "Portland, Oregon"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/16/cc/bd/64/photo0jpg.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/16/cc/bd/67/photo1jpg.jpg"], "created_at_date": "2019-03-14", "published_at_date": "2019-03-14"}, {"review_id": 658305838, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r658305838-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Cremation: a touching experience", "text": "View of 