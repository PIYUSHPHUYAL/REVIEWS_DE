 "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2017-07-31"}, "reviewer": {"reviewer_id": "B430A8A40D0E5A3AB1A9E1A26FF49C9A", "name": "Manjanath B", "profile_link": "https://www.tripadvisor.com/Profile/bhmanju", "username": "bhmanju", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/00/7c/18/bhmanju.jpg", "contribution_count": 142, "hometown": {"tripadvisor_entity_id": 297628, "location_name": "Bengaluru", "location_name_detailed": "Bengaluru, India"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/10/34/fa/c3/mandir-entrance.jpg"], "created_at_date": "2017-08-09", "published_at_date": "2017-08-10"}, {"review_id": 509703427, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r509703427-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Makes you think about the western way of death", "text": "I was deeply moved by this place. I hired a guide and this is well worth the money. I watch a family washing the feet of their relatives and then crossed the bridge to the cremation site. At first I was shocked by the process and then realised this was far more honest than the sterile way we reality death in the west. I was deeply moved by the cremation which was not ghoolish in any way. Although the place dealt with death, I have never been to place sinfully of love and life.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2017-04-30"}, "reviewer": {"reviewer_id": "C777BA38216DDB834587F236784EFC43", "name": "cottagechris", "profile_link": "https://www.tripadvisor.com/Profile/cottagechris", "username": "cottagechris", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/f1/79/default-avatar-2020-21.jpg", "contribution_coun