ripadvisor.com/ShowUserReviews-g293890-d310712-r447545333-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Must see", "text": "This is by far the most interesting temple and historic site.  Thinking of taking home some fine scarves or pashminas? The free trade store has every quality clearly marked with prices... so no haggling!  We got some beautiful gifts and fine cashmere sweaters for ourselves.\n\nDo not miss the museum.  A tour guide would be a good idea here.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2016-11-30"}, "reviewer": {"reviewer_id": "484ED22F8ABA5BB27A4513DDF4584F4D", "name": "Denton R (Hunt Burke)", "profile_link": "https://www.tripadvisor.com/Profile/DentonR", "username": "DentonR", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e4/59/default-avatar-2020-49.jpg", "contribution_count": 15, "hometown": {"tripadvisor_entity_id": 30226, "location_name": "Alexandria", "location_name_detailed": "Alexandria, Virginia"}, "is_verified": false}, "images": [], "created_at_date": "2016-12-29", "published_at_date": "2016-12-30"}, {"review_id": 447491796, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r447491796-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Hindus big anicent temple ", "text": "Very very big and old Hindus temple.It call pasupatinath god shiva's temple.Area is big .It is situation near by Bagmati river.If Hindu people die his or her body is going to burning fire there .pls go and visit in chance.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2016-12-31"}, "reviewer": {"reviewer