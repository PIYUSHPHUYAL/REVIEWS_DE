6-12-31"}, "reviewer": {"reviewer_id": "89DAC74799035DB99B02425CCC983158", "name": "Satish G", "profile_link": "https://www.tripadvisor.com/Profile/938satishg", "username": "938satishg", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0f/1b/4d/09/satish-g.jpg", "contribution_count": 30, "hometown": {"tripadvisor_entity_id": 293890, "location_name": "Kathmandu", "location_name_detailed": "Kathmandu, Nepal"}, "is_verified": false}, "images": [], "created_at_date": "2016-12-29", "published_at_date": "2016-12-29"}, {"review_id": 447359913, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r447359913-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Heart warming", "text": "Though the temple is crowded with people pushing for darshan, the site of God in His form is heart warming. Places of destruction still remaining following the earthquake. No proper road with chaos at the entrance. The experience of the Divine is never less.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2016-12-31"}, "reviewer": {"reviewer_id": "5B7FD0BF553FFCB9F60BE84F76100CCD", "name": "ssn05", "profile_link": "https://www.tripadvisor.com/Profile/ssn05", "username": "ssn05", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/77/ae/default-avatar-2020-2.jpg", "contribution_count": 66, "hometown": {"tripadvisor_entity_id": 1162345, "location_name": "Salem", "location_name_detailed": "Salem, India"}, "is_verified": false}, "images": [], "created_at_date": "2016-12-29", "published_at_date": "2016-12-29"}, {"review_id": 447065575, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r447065575-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Its Heven", "text": "Its unbelievable site i don't have words to describe....very good management security and everything but be care full of monkeys....", "review_tip": null, "rating": 5, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2016-12-31"}, "reviewer": {"reviewer_id": "3C319CC9D13CE43EA3C3FF9E09C3C931", "name": "Yatin S", "profile_link": "https://www.tripadvisor.com/Profile/449yatins", "username": "449yatins", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/eb/a3/default-avatar-2020-38.jpg", "contribution_count": 28, "hometown": {"tripadvisor_entity_id": 12400025, "location_name": "Pune District", "location_name_detailed": "Pune District, India"}, "is_verified": false}, "images": [], "created_at_date": "2016-12-28", "published_at_date": "2016-12-28"}, {"review_id": 447062197, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r447062197-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Compelling place", "text": "A compelling and somewhat sobering place. Pashupatinath is not as touristy as other sights, but there were visitors. The burning ghats are sombre and the place has a strong spiritual sense. The architecture is old and striking to view. There are a hatful of touts and be wary the Sahdus will ask money for photgraphs. A must visit if you have an interest in the Hindu rituals in Nepal.", "review_tip": null, "rating": 4, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2016-12-31"}, "reviewer": {"reviewer_id": "958395D35E7A4A5747614486B42FCE11", "name": "book_of_dreams", "profile_link": "https://www.tripadvisor.com/Profile/book_of_dreams", "username": "book_of_dreams", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/ea/74/default-avatar-2020-68.jpg", "contribution_count": 145, "hometown": {"tripadvisor_entity_id": 255055, "location_name": "Australia", "location_name_detailed": "Australia"}, "is_verified": false}, "images": [], "created_at_date": "2016-12-28", "published_at_date": "2016-12-28"}, {"review_id": 446978353, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r446978353-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Great Expectations but Average", "text": "Since childhood I had heard a lot abt this temple but did not find it to very great. The main temple isn't very big and will take just 10-15 mins max before you can finish the tour.I was very disappointed when I was Informed that no kind of photography is allowed inside not even cell phone, being a photographer this turned me off .\nSince I went around 2 pm I could not see the idol and there were just a few people around . If you want to see the Prayer ceremony and the Idol check the local timings before you go.\nFootwear need to be deposited before you enter the temple area in a rug sack provided there and the service is free of charge.\nIF U LIKED MY REVIEW OR THINK ITS HELPFUL PLZ CLICK THE \"THANK\" BUTTON BELOW.", "review_tip": null, "rating": 3, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2016-12-31"}, "reviewer": {"reviewer_id": "C1BF7954FBD130664CFE7C20029AB3DC", "name": "Gourav99", "profile_link": "https://www.tripadvisor.com/Profile/Gourav99", "username": "Gourav99", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/e3/a1/84/gouravs99.jpg", "contribution_count": 372, "hometown": {"tripadvisor_entity_id": 297628, "location_name": "Bengaluru", "location_name_detailed": "Bengaluru, India"}, "is_verified": false}, "images": [], "created_at_date": "2016-12-27", "published_at_date": "2016-12-28"}, {"review_id": 446972909, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r446972909-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Great Expectations but Nothing Great", "text": "Since childhood I had heard a lot abt this temple but did not find it to very great. The main temple isn't very big and will take just 10-15 mins max before you can finish the tour.I was very disappointed when I was Informed that no kind of photography is allowed inside not even cell phone, being a photographer this turned me off .\nSince I went around 2 pm I could not see the idol and there were just a few people around . If you want to see the Prayer ceremony and the Idol check the local timings before you go.\nFootwear need to be deposited before you enter the temple area in a rug sack provided there and the service is free of charge.\nIF U LIKED MY REVIEW OR THINK ITS HELPFUL PLZ CLICK THE \"THANK\" BUTTON BELOW. \n", "review_tip": null, "rating": 3, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2016-12-31"}, "reviewer": {"reviewer_id": "C1BF7954FBD130664CFE7C20029AB3DC", "name": "Gourav99", "profile_link": "https://www.tripadvisor.com/Profile/Gourav99", "username": "Gourav99", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/e3/a1/84/gouravs99.jpg", "contribution_count": 372, "hometown": {"tripadvisor_entity_id": 297628, "location_name": "Bengaluru", "location_name_detailed": "Bengaluru, India"}, "is_verified": false}, "images": [], "created_at_date": "2016-12-27", "published_at_date": "2016-12-28"}, {"review_id": 446941714, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r446941714-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Special atmosphere", "text": "On a trip to Nepal I always g