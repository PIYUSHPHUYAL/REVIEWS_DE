{"scraped_at": "2026-06-04T07:26:16.694941+00:00", "run_id": "20260604_072616", "page": 92, "api_response": {"count": 3946, "per_page": 20, "current_page": 92, "total_pages": 198, "next": "https://tripadvisor-scraper-api.omkar.cloud/reviews?query=https%3A%2F%2Fwww.tripadvisor.com%2FAttraction_Review-g293890-d310712-Reviews-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html&page=93&sort_by=most_recent&locale=en-US", "previous": "https://tripadvisor-scraper-api.omkar.cloud/reviews?query=https%3A%2F%2Fwww.tripadvisor.com%2FAttraction_Review-g293890-d310712-Reviews-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html&page=91&sort_by=most_recent&locale=en-US", "results": [{"review_id": 449115877, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r449115877-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Burning Ghat", "text": "Only hindus can enter the actual temple, but you can walk around the area and visit the burning ghat. Takes a while to process the fact that you are seeing bodies being cremated in front of you. Make sure you show respect, don't take photos and don't stick around for too long. \nI personally didn't find this temple particularly interesting, but visited it anyway because of it's historical significance and world heritage status. ", "review_tip": null, "rating": 3, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2016-12-31"}, "reviewer": {"reviewer_id": "BA1272560FFF4711D99438AD82535825", "name": "oannao", "profile_link": "https://www.tripadvisor.com/Profile/oannao", "username": "oannao", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/0c/18/15/f6/oannao.jpg", "contribution_count": 157, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2017-01-04", "publis