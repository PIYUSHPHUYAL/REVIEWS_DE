tity_id": 298570, "location_name": "Kuala Lumpur", "location_name_detailed": "Kuala Lumpur, Malaysia"}, "is_verified": false}, "images": [], "created_at_date": "2019-01-12", "published_at_date": "2019-01-12"}, {"review_id": 645270917, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r645270917-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Worship for Lord Shiva", "text": "Historic temple of lord Shiva also known as pashupati nath here.. It's a Hindu temple.. Great place of worship..", "review_tip": null, "rating": 5, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2019-01-31"}, "reviewer": {"reviewer_id": "C25CB4429CC54B269C5D502A8BAE61F0", "name": "Abhinav P", "profile_link": "https://www.tripadvisor.com/Profile/96abhinavp", "username": "96abhinavp", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/07/4e/de/43/abhinav-p.jpg", "contribution_count": 155, "hometown": {"tripadvisor_entity_id": 304551, "location_name": "New Delhi", "location_name_detailed": "New Delhi, India"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/16/10/8e/66/img-20181226-102938133.jpg"], "created_at_date": "2019-01-12", "published_at_date": "2019-01-12"}, {"review_id": 645236318, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r645236318-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "wonderful experience", "text": "A large temple complex - almost a small Varanasi. This is a famous Shiva temple which is a world heritage site. You can't enter unless you are Hindu but it is still worth exploring. The complex is large and the sight of cremations on the ghat are a revelation- please be respectful with your cameras", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2018-11-30"}, "reviewer": {"reviewer_id": "9B9B0087BD84018873F5E2A03D44F672", "name": "s k", "profile_link": "https://www.tripadvisor.com/Profile/sankes", "username": "sankes", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e8/91/default-avatar-2020-62.jpg", "contribution_count": 580, "hometown": {"tripadvisor_entity_id": 186411, "location_name": "Leeds", "location_name_detailed": "Leeds, United Kingdom"}, "is_verified": false}, "images": [], "created_at_date": "2019-01-12", "published_at_date": "2019-01-12"}, {"review_id": 644206070, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r644206070-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "The Temple-A Must Visit Pilgrimage", "text": "This is a must visit place for all. Its a Pilgrimage. You are fortunate to be at this place to see Jyotirling of Swyambhu Shankar. A nice, well managed place, where a lot of people visit, Hindus specially. Don't treat it a tourist attraction, but if you want to see and feel divinity,  Hindu shraddha and devotion, you must visit. It is advisable that if you are visiting in morning, visit around 11 a.m., when you will be able to have special darhan / view of Swyambhu God at around 12 a.m. For proper Darshan and Pooja, it is a good idea to engage a Pandit / Panda, who will properly show you the temple and perform Pooja. I was charged Rs. 11,00/- (Nepali Rupees) ( Equivalent to about 700 Indian Rupees), but it is worth. If you are in Kathmandu, its a must visit place. \nTake care not to buy anything, specially Rudraksha, as you will end up buying fake products. Most of the Rudraksha, which will be offered to you ( Ek Mukhi) are a farce. Avoid buying. If you can't resist your temptation, at least bargain heavily. There is no standard in pricing, which are mostly multifold.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2018-12-31"}, "reviewer": {"reviewer_id": "DBB3F121BAE890B6EBBB851406EA3EE7", "name": "Vijay Dalmia Advocate", "profile_link": "https://www.tripadvisor.com/Profile/VijayDalmiaAdvocate", "username": "VijayDalmiaAdvocate", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/09/64/9b/10/vijay-d.jpg", "contribution_count": 65, "hometown": {"tripadvisor_entity_id": 644043, "location_name": "Noida", "location_name_detailed": "Noida, India"}, "is_verified": false}, "images": [], "created_at_date": "2019-01-07", "published_at_date": "2019-01-07"}, {"review_id": 644199293, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r644199293-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "A must Visit Temple, Can't miss while in Nepal", "text": "Its a special divine experience when you visit Pashupati Nath Temple at Kathmandu. No recommendations or explanations needed. Just go for it and experience the divine. ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2018-12-31"}, "reviewer": {"reviewer_id": "DBB3F121BAE890B6EBBB851406EA3EE7", "name": "Vijay Dalmia Advocate", "profile_link": "https://www.tripadvisor.com/Profile/VijayDalmiaAdvocate", "username": "VijayDalmiaAdvocate", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/09/64/9b/10/vijay-d.jpg", "contribution_count": 65, "hometown": {"tripadvisor_entity_id": 644043, "location_name": "Noida", "location_name_detailed": "Noida, India"}, "is_verified": false}, "images": [], "created_at_date": "2019-01-07", "published_at_date": "2019-01-