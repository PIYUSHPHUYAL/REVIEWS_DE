{"scraped_at": "2026-06-04T07:26:16.694941+00:00", "run_id": "20260604_072616", "page": 50, "api_response": {"count": 3946, "per_page": 20, "current_page": 50, "total_pages": 198, "next": "https://tripadvisor-scraper-api.omkar.cloud/reviews?query=https%3A%2F%2Fwww.tripadvisor.com%2FAttraction_Review-g293890-d310712-Reviews-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html&page=51&sort_by=most_recent&locale=en-US", "previous": "https://tripadvisor-scraper-api.omkar.cloud/reviews?query=https%3A%2F%2Fwww.tripadvisor.com%2FAttraction_Review-g293890-d310712-Reviews-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html&page=49&sort_by=most_recent&locale=en-US", "results": [{"review_id": 584674196, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r584674196-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Open your mind to a different culture ", "text": "This is a Hindu temple and once in their lifetime, Hindus are required to pilgramage here.. located on the bagmati river (which eventually flows into the Ganges In India), you will see cremations occurring on edge of the river..\n\nMonkeys galore and the occasional cow can also be found wandering through the complex.. only Hindus are permitted inside the golden temple, but you get good views from up the hill..\n\nBe warned of the guides.. even if you say no, they will follow you and expect a tip at the end...\n\nDefinite location to spend a couple of hours to see into a different culture with so much activity and colour particularly on Saturdays..", "review_tip": null, "rating": 5, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2018-05-31"}, "reviewer": {"reviewer_id": "45CC14905212EBA75E370E2F50E6B49D", "name": "thegratefultourist", "profile_link": "https://www.tripadvisor.com/Profile/thegratefultourist", "username": "thegratefultourist", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/15/51/1b/00/caption.jpg", "contribution_count": 49, "hometown": {"tripadvisor_entity_id": 255103, "location_name": "Perth", "location_name_detailed": "Perth, Australia"}, "is_verified": false}, "images": [], "created_at_date": "2018-06-03", "published_at_date": "2018-06-03"}, {"review_id": 584479888, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r584479888-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Every one has to visit Jai Pashupati Nath ..", "text": "The Pashupatinath Temple is a famous and sacred Hindu temple complex that is located on the banks of the Bagmati River, approximately 5 kilometres north-east of Kathmandu in the eastern part of Kathmandu Valley, the capital of Nepal.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2018-05-31"}, "reviewer": {"reviewer_id": "A39FBCEF09A52BBF12063D8C1AFCE690", "name": "Govind Tiwari", "profile_link": "https://www.tripadvisor.com/Profile/govindt858", "username": "govindt858", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/13/2a/b4/a5/govind-t.jpg", "contribution_count": 16, "hometown": {"tripadvisor_entity_id": 297608, "location_name": "Ahmedabad", "location_name_detailed": "Ahmedabad, India"}, "is_verified": false}, "images": [], "created_at_date": "2018-06-02", "published_at_date": "2018-06-02"}, {"review_id": 584266129, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r584266129-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Cultural Experience", "text": "Only Hindus are allowed inside; however, non-Hindus can visit the areas surrounding the temple and even observe the open cremations. This is an important pilgrimage site for Hindus and is designated a UNESCO world cultural site as well. A cultural must do when in Kathmandu in my opinion.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2018-05-31"}, "reviewer": {"reviewer_id": "289189F3F317B95760032C599647B882", "name": "fiamma11", "profile_link": "https://www.tripadvisor.com/Profile/fiamma11", "username": "fiamma11", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/06/a5/81/c0/fiamma11.jpg", "contribution_count": 6606, "hometown": {"tripadvisor_entity_id": 58258, "location_name": "Tysons Corner", "location_name_detailed": "Tysons Corner, Virginia"}, "is_verified": false}, "images": [], "created_at_date": "2018-06-01", "published_at_date": "2018-06-01"}, {"review_id": 584177486, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r584177486-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Surprise more monkeys and a calm local feel", "text": "This enormous compound is worth the 1000 (~$10 US) because it's a gorgeous and large-scale site. So many nooks and crannies, fancy wood work, temples, and relaxed calm tourists and locals enjoying the scene. Also, we didn't expect monkeys there but there were! ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2018-05-31"}, "reviewer": {"reviewer_id": "F05740F0C705D3BA21C93EDFC556BEB1", "name": "S4B1B4", "profile_link": "https://www.tripadvisor.com/Profile/S4B1B4", "username": "S4B1B4", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e7/7b/default-avatar-2020-56.jpg", "contribution_count": 65, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2018-05-31", "published_at_date": "2018-05-31"}, {"review_id": 584056876, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r584056876-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Wonderful Arti", "text": "\nMy Guide from Swotah Travel took me to Pashupati at evening for Aarati, It was surreal. I really loved the spiritual ambiance there.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2018-04-30"}, "reviewer": {"reviewer_id": "59705B473BD590508BF4DDDF1CA1041B", "name": "Jamina B", "profile_link": "https://www.tripadvisor.com/Profile/598jaminab", "username": "598jaminab", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e4/59/default-avatar-2020-49.jpg", "contribution_count": 18, "hometown": {"tripadvisor_entity_id": 187768, "location_name": "Italy", "location_name_detailed": "Italy"}, "is_verified": false}, "images": [], "created_at_date": "2018-05-31", "published_at_date": "2018-05-31"}, {"review_id": 584053776, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r584053776-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Religious", "text": "Pashupatinath temple had been place in my heart begin Hindu and grown in and around this place. I would not rate this as my  review or rating. If you are religious person of any religion and had tolerance to accept other view, do visit and see this world heritage site.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "business", "stay_date": "2018-05-31"}, "reviewer": {"reviewer_id": "87761E32762F6AD0C69E19155537728E", "name": "Sulakshan A", "profile_link": "https://www.tripadvisor.com/Profile/SulakshanA1", "username": "SulakshanA1", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/ec/3d/default-avatar-2020-1.jpg", "contribution_count": 21, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2018-05-31", "published_at_date": "2018-05-31"}, {"review_id": 584023739, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r584023739-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "You need at least 3 hours to experience this temple!", "text": "Definitely worth going! We visited the temple on May 2018, went there about 3pm and stayed to around sunset. It is a beautiful temple, covering quite a big area, so you definitely need a guide. There are plenty available at the entrance, where you can also purchase your ticket. I would recommend to negotiate the price with the guide beforehand!", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "solo", "stay_date": "2018-05-31"}, "reviewer": {"reviewer_id": "F2833020D3798EABFC270FB0EDA12D71", "name": "Veli Y", "profile_link": "https://www.tripadvisor.com/Profile/469veliy", "username": "469veliy", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/f1/42/default-avatar-2020-20.jpg", "contribution_count": 4, "hometown": {"tripadvisor_entity_id": 188633, "location_name": "The Hague", "location_name_detailed": "The Hague, The Netherlands"}, "is_verified": false}, "images": [], "created_at_date": "2018-05-31", "published_at_date": "2018-05-31"}, {"review_id": 584020582, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r584020582-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "the cremation of Burning Dead body", "text": "Its totally a different and thrilling to see burning of a dead body. I didn't see it properly but my husband took many shots of its. the Hindu culture is amazing than our Christainity. anyways,  the Temple and the other monuments were very nice. tour Guide Sujan Dhakal described a lot about its history and the cultural beliefs. amazing.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2018-03-31"}, "reviewer": {"reviewer_id": "60E3848FBE588552AB5FDDFCACC4B4E8", "name": "Leanne D", "profile_link": "https://www.tripadvisor.com/Profile/leanned727", "username": "leanned727", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/f1/b8/default-avatar-2020-22.jpg", "contribution_count": 11, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2018-05-31", "published_at_date": "2018-05-31"}, {"review_id": 583860718, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r583860718-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Jai Bholenath", "text": "before entering into temple premises, enquire about the different categories of pujas performed.\n\nhuge temple premises, open air.\n\nNON hindus cannot enter into the temple.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2018-05-31"}, "reviewer": {"reviewer_id": "9415505DE478CB1332F6BDFECF1453BF", "name": "TRAVELLERANUP", "profile_link": "https://www.tripadvisor.com/Profile/TRAVELLERANUP", "username": "TRAVELLERANUP", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e6/ea/default-avatar-2020-54.jpg", "contribution_count": 279, "hometown": {"tripadvisor_entity_id": 304558, "location_name": "Kolkata (Calcutta)", "location_name_detailed": "Kolkata (Calcutta), India"}, "is_verified": false}, "images": [], "created_at_date": "2018-05-30", "published_at_date": "2018-05-30"}, {"review_id": 583855236, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r583855236-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "historical", "text": "peace\npositive energies\nblessings\ndiscipline\ndivine\n\nyou will find it all.\nlarge temple complex, but the people there are helpfull. before entering the temple just read and get details about the different types of pujas offered. there are different categories of puja, starting from 1100 NC. \n\na must visit in lifetime.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2018-05-31"}, "reviewer": {"reviewer_id": "9415505DE478CB1332F6BDFECF1453BF", "name": "TRAVELLERANUP", "profile_link": "https://www.tripadvisor.com/Profile/TRAVELLERANUP", "username": "TRAVELLERANUP", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e6/ea/default-avatar-2020-54.jpg", "contribution_count": 279, "hometown": {"tripadvisor_entity_id": 304558, "location_name": "Kolkata (Calcutta)", "location_name_detailed": "Kolkata (Calcutta), India"}, "is_verified": false}, "images": [], "created_at_date": "2018-05-30", "published_at_date": "2018-05-30"}, {"review_id": 583792937, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r583792937-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Must visit !", "text": "One of the most sacred Hindu temples, Pashupatinath Temple should be on every traveller's list. Definitely hire a guide (you can find them around the ticket booth) in order to understand the history of the temple. The one hour tour was very insightful. \n\nYou'll witness body cremations along the river bank, be prepared for that. We went in the evening, and watched the aarti, which was really interesting!", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2018-05-31"}, "reviewer": {"reviewer_id": "02EC6A4C4C2B65FA3E06C241193B12F6", "name": "Crystal H", "profile_link": "https://www.tripadvisor.com/Profile/627CrystalH", "username": "627CrystalH", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/06/03/35/54/crystal-h.jpg", "contribution_count": 66, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2018-05-30", "published_at_date": "2018-05-30"}, {"review_id": 583596752, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r583596752-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Must visit place when in NEPAL", "text": "It is a huge temple of Lord shiva and very beautifully and artistically made indeed. You are not allowed to take pictures or videos inside the temple premises so I don't have much pictures of Temple from inside. The only thing I don't like about this temple was that deliver where the aarti is done was very dirty. 1 very strange thing that we noticed in this temple was that the funeral or the rituals before the funeral with the dead body are done in public right at the place where the aarti is held. This was something very different I've never seen that anywhere before. \nSo if you are attending the maha aarti at Pashupatinath Temple you will definitely get to see the rituals be done with the dead body before the funeral then and there. ", "review_tip": null, "rating": 4, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2018-05-31"}, "reviewer": {"reviewer_id": "D63D2A7BEAB44A9CFDC1C6F1060D5C0A", "name": "shiwangipeswani", "profile_link": "https://www.tripadvisor.com/Profile/shiwangipeswani", "username": "shiwangipeswani", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/10/f9/d5/e8/shiwangipeswani.jpg", "contribution_count": 372, "hometown": {"tripadvisor_entity_id": 297683, "location_name": "Agra", "location_name_detailed": "Agra, India"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/13/1a/c6/ea/img-20180513-182736-largejpg.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/13/1a/c6/eb/img-20180513-192855-largejpg.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/13/1a/c6/ec/img-20180513-192847-largejpg.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/13/1a/c6/ed/img-20180513-182716-largejpg.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/13/1a/c6/ee/img-20180513-182741-largejpg.jpg"], "created_at_date": "2018-05-29", "published_at_date": "2018-05-29"}, {"review_id": 583054040, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r583054040-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Learn about it before going to decide if it’s for you", "text": "For anyone not fully aware do your research before deciding to go, this is an open air crematorium and there will be deceased persons visible, we saw faces of the deceased and bodies being burnt on cremation pyres. \nWhile it is a great insight into Hindu burial and apparently an honour for the families for people to observe a cremation it may not be for everyone and could be confronting. The ashes of the deceased need to flow into the Bagmati river as this flows into the Ganges in India and is of great religious importance. It was a humbling sobering but also a touching experience.\n", "review_tip": null, "rating": 4, "subratings": [], "like_count": 3, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2018-05-31"}, "reviewer": {"reviewer_id": "2E88F7A8E8DF182C9388BD3223D026FD", "name": "creativeklm", "profile_link": "https://www.tripadvisor.com/Profile/creativeklm", "username": "creativeklm", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e9/bb/default-avatar-2020-65.jpg", "contribution_count": 28, "hometown": {"tripadvisor_entity_id": 255100, "location_name": "Melbourne", "location_name_detailed": "Melbourne, Australia"}, "is_verified": false}, "images": [], "created_at_date": "2018-05-27", "published_at_date": "2018-05-27"}, {"review_id": 583049908, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r583049908-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Historical Temple", "text": "Pashupathi Nath is In the city centre of Kathmandu. It is historically a significant temple in Nepal. Read up on this Temple before your visit as this will add value to  your trip. I enjoyed my visit here. Decent dress code applies at this Temple as all others do.You will also have to remove shoes whilst visiting the Temple.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2018-04-30"}, "reviewer": {"reviewer_id": "2EE2C07471B50CD76C015FB01016B1D5", "name": "Golfnut5472", "profile_link": "https://www.tripadvisor.com/Profile/Golfnut5472", "username": "Golfnut5472", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e3/6a/default-avatar-2020-47.jpg", "contribution_count": 149, "hometown": {"tripadvisor_entity_id": 312578, "location_name": "Johannesburg", "location_name_detailed": "Johannesburg, South Africa"}, "is_verified": false}, "images": [], "created_at_date": "2018-05-27", "published_at_date": "2018-05-27"}, {"review_id": 582953010, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r582953010-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Impressive", "text": "It is a large temple complex and as expected it is always crowded. Avoid late mornings and evenings. The evening Aarti is quite nice. ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "family", "stay_date": "2018-05-31"}, "reviewer": {"reviewer_id": "CBF73B894CEB6366382FDCAAE88C10F8", "name": "Subramanya S", "profile_link": "https://www.tripadvisor.com/Profile/SubramanyaS24", "username": "SubramanyaS24", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/f2/11/default-avatar-2020-23.jpg", "contribution_count": 53, "hometown": {"tripadvisor_entity_id": 297628, "location_name": "Bengaluru", "location_name_detailed": "Bengaluru, India"}, "is_verified": false}, "images": [], "created_at_date": "2018-05-27", "published_at_date": "2018-05-27"}, {"review_id": 582643497, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r582643497-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Dev Darshan heritage place.", "text": "A heritage Shiva temple with good landscaping and arrangements made for easy pooja in the temple. Within 1 km of the Airport.  There is a market near parking with restaurants and  selling chinese cheap quality items.", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2018-05-31"}, "reviewer": {"reviewer_id": "77C9840569DCC952B20C474005F27CDD", "name": "asodhia", "