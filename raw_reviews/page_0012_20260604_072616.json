/photo9jpg.jpg"], "created_at_date": "2020-02-23", "published_at_date": "2020-02-23"}, {"review_id": 746471572, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r746471572-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Shivaratri", "text": "Wow! Not for the feint hearted or socially phobic. Large thronging masses. Like a mosh pit at at times without the fear of being assaulted robbed or exploited. The Babas and sadhus will keep you entertained with their crazed antics. Dogs monkeys goats cats and cows welcome too. Get in and out early. ", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "friends", "stay_date": "2020-02-29"}, "reviewer": {"reviewer_id": "40E82E775CE8E882DF0709615611A39D", "name": "Troy P", "profile_link": "https://www.tripadvisor.com/Profile/651troyp", "username": "651troyp", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/e2/e6/default-avatar-2020-45.jpg", "contribution_count": 24, "hometown": {"tripadvisor_entity_id": 1426078, "location_name": "Blue Mountains", "location_name_detailed": "Blue Mountains, Australia"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f5/bf/1d/photo0jpg.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f5/bf/1e/photo1jpg.jpg"], "created_at_date": "2020-02-21", "published_at_date": "2020-02-22"}, {"review_id": 746651561, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r746651561-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Great place for Hindus", "text": "I have been lot of Hindus Temple this one is the first one I would like to recommend dear all visit this place once in your life. Which is real heaven on earth\n", "review_tip": null, "rating": 5, "subrati