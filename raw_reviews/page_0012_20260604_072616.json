inath-shiva-s.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1b/2a/67/bc/pashupatinath-shiva-s.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1b/2a/67/bd/pashupatinath-shiva-s.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1b/2a/67/c0/pashupatinath-shiva-s.jpg"], "created_at_date": "2020-03-15", "published_at_date": "2020-03-16"}, {"review_id": 750756597, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r750756597-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Must visit", "text": "It is an obvious choice for visitor of Kathmandu. Do plan your visit to keep at least a couple of hours as the temple will usually have long que. also factor in the Kathmandu traffic. This place is next to the airport and the roads are invariably jammed. Do visit the guhyeshwari Shakti peeth which is adjacent to the Pashupatinath temple. ", "review_tip": null, "rating": 5, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": null, "stay_date": "2019-10-31"}, "reviewer": {"reviewer_id": "2E7648FACE4C9EAA3A7E313304D460A5", "name": "Sri", "profile_link": "https://www.tripadvisor.com/Profile/Srionthego", "username": "Srionthego", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/7c/01/default-avatar-2020-5.jpg", "contribution_count": 9, "hometown": null, "is_verified": false}, "images": [], "created_at_date": "2020-03-13", "published_at_date": "2020-03-13"}, {"review_id": 750593571, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r750593571-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Worth a visit", "text": "It is worth a visit if you are in Kathmandu and it is a UNESCO World Heritage site. On the left hand side of the temple you can see cremation of bodies. There are lot of Hindu devotees who come to visit the temple. However unless you are a Nepalese or Indian Hindu you are not allowed to enter the temple which is a shame", "review_tip": null, "rating": 4, "subratings": [], "like_count": 0, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": null, "stay_date": "2020-03-31"}, "reviewer": {"reviewer_id": "78733E82A1FDD4B46B3A8C2B62008755", "name": "HGC_13", "profile_link": "https://www.tripadvisor.com/Profile/HGC_13", "username": "HGC_13", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/77/ae/default-avatar-2020-2.jpg", "contribution_count": 203, "hometown": {"tripadvisor_entity_id": 255337, "location_name": "Gold Coast", "location_name_detailed": "Gold Coast, Australia"}, "is_verified": false}, "images": [], "created_at_date": "2020-03-12", "published_at_date": "2020-03-12"}, {"review_id": 750396224, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r750396224-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Not one of my favorite places in Kathmandu but must visit...", "text": "After Bougha Stupa it was a mistake to visit the temple. Beggars claiming themselves “sadhus”, non stop cremation which everyone can see and be present, for Hindus must be their shrine, but for foreigners and not Hindus a bit creepy place... I felt heavy energy of death there... the guide also was telling about goodness Kali and which immolation people do wishing something from this goodness. Place is dirty and full of people, however if you are in Kathmandu than must visit...", "review_tip": null, "rating": 3, "subratings": [], "like_count": 2, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2020-02-29"}, "reviewer": {"reviewer_id": "C4E30EB294B7E238E51642624D052D48", "name": "Alina2016", "profile_link": "https://www.tripadvisor.com/Profile/Alina2016", "username": "Alina2016", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/2f/e5/21/d7/caption.jpg", "contribution_count": 162, "hometown": {"tripadvisor_entity_id": 154943, "location_name": "Vancouver", "location_name_detailed": "Vancouver, Canada"}, "is_verified": false}, "images": ["https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1b/22/e8/31/photo0jpg.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1b/22/e8/32/photo1jpg.jpg", "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1b/22/e8/33/photo2jpg.jpg"], "created_at_date": "2020-03-11", "published_at_date": "2020-03-11"}, {"review_id": 750041675, "review_link": "https://www.tripadvisor.com/ShowUserReviews-g293890-d310712-r750041675-Pashupatinath_Temple-Kathmandu_Kathmandu_Valley_Bagmati_Zone_Central_Region.html", "title": "Don't go there. Much better temples to be seen elsewhere.", "text": "It's dirty, full of people, disorganised, they charge you 1000NRS as a foreigner and don't even let you into the main temple. They don't tell you this when you buy your ticket. It's also an active cremation ground, so you will see bodies being burnt and bodies brought over. I'd rather spend my time at the Swayambunath or Boudinath temples where its peaceful and inclusive.", "review_tip": null, "rating": 1, "subratings": [], "like_count": 1, "language": "en", "is_translated": false, "original_language": "en", "owner_response": null, "trip": {"trip_type": "couples", "stay_date": "2020-02-29"}, "reviewer": {"reviewer_id": "F68783307DEE71D9E03003B64A10E093", "name": "Magsie111", "profile_link": "https://www.tripadvisor.com/Profile/Magsie111", "username": "Magsie111", "avatar": "https://dynamic-media-cdn.tripadvisor.com/media/photo-o/1a/f6/eb/6d/default-avatar-2020-19.jpg", "contribution_count": 33, "hometown": {"tripadvisor_entity_id": 186338, "location_name": "London", "location_name_detailed": "London, United Kingdom"}, "is_verified": false}, "images